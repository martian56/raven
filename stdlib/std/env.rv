// std.env: command-line arguments, environment variables, process exit,
// and platform info. The primitives bind the raven-runtime C ABI through
// `extern "C"`; the rest is pure Raven. See docs/guide/stdlib/env.md.

extern "C" {
    fun raven_env_get(name: str) -> str
    fun raven_env_has(name: str) -> bool
    fun raven_env_arg_count() -> int
    fun raven_env_arg_at(index: int) -> str
    fun raven_env_exit(code: int)
    fun raven_env_os_name() -> str
    fun raven_env_arch() -> str
    fun raven_env_set(name: str, value: str) -> bool
    fun raven_env_current_dir() -> str
    fun raven_env_unset(name: str) -> bool
}

// Value of the environment variable `name`, or "" when it is unset.
// An unset variable and one set to "" both return ""; use `has_env` to
// tell them apart.
fun get_env(name: str) -> str {
    return raven_env_get(name)
}

// Whether `name` is set in the environment, regardless of its value.
fun has_env(name: str) -> bool {
    return raven_env_has(name)
}

// Value of `name`, or `default` when `name` is unset.
fun get_env_or(name: str, default: str) -> str {
    if has_env(name) {
        return get_env(name)
    }
    return default
}

// Number of process arguments, including the program path at index 0.
fun arg_count() -> int {
    return raven_env_arg_count()
}

// Process argument at `i` (index 0 is the program path), or "" when `i`
// is out of range.
fun arg_at(i: int) -> str {
    return raven_env_arg_at(i)
}

// All process arguments, index 0 being the program path.
fun args() -> list[str] {
    let out: list[str] = []
    var i = 0
    let n = arg_count()
    while i < n {
        out.push(arg_at(i))
        i = i + 1
    }
    return out
}

// Terminate the process with status `code`. Does not return.
fun exit(code: int) {
    raven_env_exit(code)
}

// Target operating system: "windows", "linux", or "macos".
fun os_name() -> str {
    return raven_env_os_name()
}

// Target CPU architecture, for example "x86_64" or "aarch64".
fun arch() -> str {
    return raven_env_arch()
}

// Set an environment variable for this program and the programs it starts.
// False when the name is empty or holds `=`.
fun set_env(name: str, value: str) -> bool {
    return raven_env_set(name, value)
}

// Remove an environment variable, so it is unset for programs started
// afterwards. False when the name is empty or holds `=`.
fun unset_env(name: str) -> bool {
    return raven_env_unset(name)
}

// The current working directory, with forward slashes; "" when unknown.
fun current_dir() -> str {
    return raven_env_current_dir()
}
