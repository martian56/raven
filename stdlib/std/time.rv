// std.time: date and time over the raven-runtime C ABI, backed by chrono
// in UTC. All timestamps are Unix seconds (or milliseconds) in UTC; there
// is no local-timezone handling. The primitives bind `raven_time_*`
// symbols through `extern "C"`; the structs are assembled in pure Raven
// from scalar component extractors because a struct cannot cross the FFI
// boundary. Parsing is fallible and returns Result[int, Error] through the
// runtime's thread-local last-error slot. See docs/guide/stdlib/time.md.

from std.error import error_kind

class Date {
    year: int
    month: int
    day: int
}

class Time {
    hour: int
    minute: int
    second: int
}

class DateTime {
    date: Date
    time: Time
}

extern "C" {
    fun raven_time_last_error() -> str
    fun raven_time_now() -> int
    fun raven_time_now_millis() -> int
    fun raven_time_year(ts: int) -> int
    fun raven_time_month(ts: int) -> int
    fun raven_time_day(ts: int) -> int
    fun raven_time_hour(ts: int) -> int
    fun raven_time_minute(ts: int) -> int
    fun raven_time_second(ts: int) -> int
    fun raven_time_weekday(ts: int) -> int
    fun raven_time_format(ts: int, pattern: str) -> str
    fun raven_time_parse(text: str, pattern: str) -> int
    fun raven_time_sleep_millis(ms: int)
    fun raven_time_format_rfc3339(ms: int, offset_minutes: int) -> str
    fun raven_time_parse_rfc3339(text: str) -> int
    fun raven_time_local_offset(ts: int) -> int
    fun raven_time_monotonic_nanos() -> int
}

// Current Unix timestamp in whole seconds (UTC).
fun now() -> int {
    return raven_time_now()
}

// Current Unix time in milliseconds (UTC).
fun now_millis() -> int {
    return raven_time_now_millis()
}

// Decompose a Unix timestamp (seconds, UTC) into a DateTime, assembled in
// Raven from the per-component runtime extractors.
fun from_timestamp(ts: int) -> DateTime {
    let d = Date(year: raven_time_year(ts), month: raven_time_month(ts), day: raven_time_day(ts))
    let t = Time(
        hour: raven_time_hour(ts),
        minute: raven_time_minute(ts),
        second: raven_time_second(ts),
    )
    return DateTime(date: d, time: t)
}

// Weekday of `ts` (UTC) as 0 for Sunday through 6 for Saturday.
fun weekday(ts: int) -> int {
    return raven_time_weekday(ts)
}

// Format the UTC datetime of `ts` with a chrono strftime `pattern`, for
// example "%Y-%m-%d %H:%M:%S".
fun format_timestamp(ts: int, pattern: str) -> str {
    return raven_time_format(ts, pattern)
}

// Parse a UTC datetime `text` by a chrono strftime `pattern`, returning
// the Unix timestamp in seconds. On a parse failure returns an Error
// tagged with kind "time".
fun parse_timestamp(text: str, pattern: str) -> Result[int, Error] {
    let ts = raven_time_parse(text, pattern)
    if raven_time_last_error().length() > 0 {
        return Err(error_kind("time", "parse: ".concat(raven_time_last_error())))
    }
    return Ok(ts)
}

// Sleep the current thread for `ms` milliseconds.
fun sleep_millis(ms: int) {
    raven_time_sleep_millis(ms)
}

// Left-pad the base-ten text of `n` with zeros to at least `width` digits.
// Negative values are not expected for the calendar fields used here, so
// the sign is not handled specially.
fun pad2(n: int) -> str {
    if n < 10 {
        return "0".concat("${n}")
    }
    return "${n}"
}

fun pad4(n: int) -> str {
    if n < 0 {
        // Keep the sign in front of the zero fill: year -1 is "-0001", not
        // "000-1". The calendar year range stays well within int, so negating
        // the magnitude here does not overflow.
        return "-".concat(pad4(0 - n))
    }
    if n < 10 {
        return "000".concat("${n}")
    }
    if n < 100 {
        return "00".concat("${n}")
    }
    if n < 1000 {
        return "0".concat("${n}")
    }
    return "${n}"
}

impl ToString for Date {
    fun to_string(self) -> str {
        return pad4(self.year).concat("-").concat(pad2(self.month)).concat("-").concat(
            pad2(self.day),
        )
    }
}

impl ToString for Time {
    fun to_string(self) -> str {
        return pad2(self.hour).concat(":").concat(pad2(self.minute)).concat(":").concat(
            pad2(self.second),
        )
    }
}

impl ToString for DateTime {
    fun to_string(self) -> str {
        return self.date.to_string().concat(" ").concat(self.time.to_string())
    }
}

// Unix seconds as RFC 3339 in UTC: `2026-11-23T09:30:00Z`.
fun format_rfc3339(ts: int) -> str = raven_time_format_rfc3339(ts * 1000, 0)

// Unix milliseconds as RFC 3339 at a UTC offset in minutes (0 gives `Z`):
// `2026-11-23T13:30:00.250+04:00`. Milliseconds appear only when nonzero.
fun format_rfc3339_millis(ms: int, offset_minutes: int) -> str = raven_time_format_rfc3339(
    ms,
    offset_minutes,
)

// Parse an RFC 3339 timestamp with any offset to Unix milliseconds. A space
// may stand in for the `T`.
fun parse_rfc3339_millis(text: str) -> Result[int, Error] {
    let ms = raven_time_parse_rfc3339(text)
    let msg = raven_time_last_error()
    if msg.length() > 0 {
        return Err(error_kind("time", msg))
    }
    return Ok(ms)
}

// Parse an RFC 3339 timestamp to Unix seconds (fractions dropped).
fun parse_rfc3339(text: str) -> Result[int, Error] {
    let ms = parse_rfc3339_millis(text)?
    return Ok(_floor_div(ms, 1000))
}

// The local time zone's offset from UTC in seconds at Unix time `ts`
// (positive east of Greenwich). It changes with daylight saving time.
fun local_offset_seconds(ts: int) -> int = raven_time_local_offset(ts)

fun _floor_div(a: int, b: int) -> int {
    let q = a / b
    return q - 1 if (a % b != 0) and ((a < 0) != (b < 0)) else q
}

fun is_leap_year(year: int) -> bool = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0

fun days_in_month(year: int, month: int) -> int {
    if month == 2 {
        return 29 if is_leap_year(year) else 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 {
        return 30
    }
    return 31
}

// Midnight UTC of the day containing `ts`.
fun start_of_day(ts: int) -> int = _floor_div(ts, 86400) * 86400

fun add_days(ts: int, days: int) -> int = ts + days * 86400

// The same time of day `months` months later (or earlier, when negative),
// with the day clamped to the target month's length: Jan 31 plus one month
// is Feb 28 or 29.
fun add_months(ts: int, months: int) -> int {
    let dt = from_timestamp(ts)
    let total = dt.date.year * 12 + (dt.date.month - 1) + months
    let year = _floor_div(total, 12)
    let month = total - year * 12 + 1
    var day = dt.date.day
    let limit = days_in_month(year, month)
    if day > limit {
        day = limit
    }
    let secs = dt.time.hour * 3600 + dt.time.minute * 60 + dt.time.second
    return _days_from_civil(year, month, day) * 86400 + secs
}

// Days since 1970-01-01 for a calendar date (proleptic Gregorian).
fun _days_from_civil(year: int, month: int, day: int) -> int {
    let y = year - 1 if month <= 2 else year
    let era = _floor_div(y, 400)
    let yoe = y - era * 400
    let mp = (month + 9) % 12
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// Unix seconds at midnight UTC on a calendar date.
fun date_to_timestamp(year: int, month: int, day: int) -> int = _days_from_civil(year, month, day) * 86400
// A span of time with nanosecond resolution.
class Duration {
    nanos: int
}

fun nanoseconds(n: int) -> Duration = Duration(nanos: n)
fun microseconds(n: int) -> Duration = Duration(nanos: n * 1000)
fun milliseconds(n: int) -> Duration = Duration(nanos: n * 1000000)
fun seconds(n: int) -> Duration = Duration(nanos: n * 1000000000)
fun minutes(n: int) -> Duration = Duration(nanos: n * 60000000000)
fun hours(n: int) -> Duration = Duration(nanos: n * 3600000000000)

impl Duration {
    fun as_nanos(self) -> int = self.nanos
    fun as_micros(self) -> int = self.nanos / 1000
    fun as_millis(self) -> int = self.nanos / 1000000
    fun as_seconds(self) -> int = self.nanos / 1000000000
    fun as_seconds_float(self) -> float = self.nanos.as_float() / 1000000000.0
    fun plus(self, other: Duration) -> Duration = Duration(nanos: self.nanos + other.nanos)
    fun minus(self, other: Duration) -> Duration = Duration(nanos: self.nanos - other.nanos)
    fun times(self, n: int) -> Duration = Duration(nanos: self.nanos * n)
    fun is_zero(self) -> bool = self.nanos == 0
}

// The largest whole unit, with up to three decimals: "1.5s", "250ms",
// "12.003µs", "2m5s", "1h0m0s".
impl ToString for Duration {
    fun to_string(self) -> str {
        let n = self.nanos
        if n < 0 {
            return "-" + Duration(nanos: 0 - n).to_string()
        }
        if n >= 60000000000 {
            let total = n / 1000000000
            let h = total / 3600
            let m = (total % 3600) / 60
            let s = total % 60
            if h > 0 {
                return "${h}h${m}m${s}s"
            }
            return "${m}m${s}s"
        }
        if n >= 1000000000 {
            return _scaled(n, 1000000000, "s")
        }
        if n >= 1000000 {
            return _scaled(n, 1000000, "ms")
        }
        if n >= 1000 {
            return _scaled(n, 1000, "µs")
        }
        return "${n}ns"
    }
}

fun _scaled(n: int, unit: int, suffix: str) -> str {
    let whole = n / unit
    var frac = (n % unit) * 1000 / unit
    if frac == 0 {
        return "${whole}${suffix}"
    }
    var digits = "${frac}"
    while digits.length() < 3 {
        digits = "0" + digits
    }
    while digits.ends_with("0") {
        digits = digits.substring(0, digits.length() - 1)
    }
    return "${whole}.${digits}${suffix}"
}

// A point on a clock that never goes backward, for measuring elapsed time.
// Unlike `now()`, it is unaffected by changes to the system clock.
class Instant {
    nanos: int
}

impl Instant {
    fun now() -> Instant = Instant(nanos: raven_time_monotonic_nanos())

    // Time since this instant.
    fun elapsed(self) -> Duration = Duration(nanos: raven_time_monotonic_nanos() - self.nanos)

    // Time from `earlier` to this instant.
    fun since(self, earlier: Instant) -> Duration = Duration(nanos: self.nanos - earlier.nanos)

    fun plus(self, d: Duration) -> Instant = Instant(nanos: self.nanos + d.nanos)
}
