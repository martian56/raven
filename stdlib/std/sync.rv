// std/sync: goroutine-style concurrency over the raven-runtime scheduler,
// which runs goroutines in parallel on a per-core worker pool. A Channel wraps
// an opaque runtime id, the same registry pattern std/net uses for sockets.
// send and recv block (suspending the goroutine back to the scheduler) when the
// channel is full or empty. This slice carries Int values; a goroutine body is
// started with the `spawn` keyword. See docs/v2/specs/concurrency.md.

extern "C" {
    fun raven_channel_new() -> int
    fun raven_channel_new_buffered(cap: int) -> int
    fun raven_channel_send(id: int, value: int)
    fun raven_channel_recv(id: int) -> int
    fun raven_go_yield()
    fun raven_waitgroup_new() -> int
    fun raven_waitgroup_add(id: int, delta: int)
    fun raven_waitgroup_wait(id: int)
    fun raven_sleep_millis(ms: int)
    fun raven_select_new() -> int
    fun raven_select_add(set_id: int, chan_id: int)
    fun raven_select_recv(set_id: int) -> int
    fun raven_select_value() -> int
    fun raven_select_free(set_id: int)
    fun raven_channel_free(id: int)
    fun raven_waitgroup_free(id: int)
}

// A channel of Int values. The id keys the runtime's channel registry.
class Channel {
    id: int
}

// Create an unbuffered (rendezvous) channel.
fun channel() -> Channel {
    return Channel(id: raven_channel_new())
}

// Create a buffered channel of capacity `cap`.
fun channel_buffered(cap: int) -> Channel {
    return Channel(id: raven_channel_new_buffered(cap))
}

impl Channel {
    // Send `value`, blocking until the channel can accept it.
    fun send(self, value: int) {
        raven_channel_send(self.id, value)
    }

    // Receive a value, blocking until one is available.
    fun recv(self) -> int {
        return raven_channel_recv(self.id)
    }

    // Release the channel's runtime registry entry. The channel must not be
    // used afterward. Call this when done to avoid leaking the entry; there is
    // no destructor.
    fun free(self) {
        raven_channel_free(self.id)
    }
}

// Yield control to the scheduler so other ready goroutines can run.
fun yield_now() {
    raven_go_yield()
}

// Sleep the current goroutine for `ms` milliseconds.
fun sleep_millis(ms: int) {
    raven_sleep_millis(ms)
}

// A mutual-exclusion lock built on a one-slot channel that holds a single
// token: the token present means unlocked, taken means locked. `lock` takes
// the token (blocking until it is returned), `unlock` returns it.
class Mutex {
    ch: Channel
}

// Create an unlocked mutex.
fun mutex() -> Mutex {
    let m = Mutex(ch: channel_buffered(1))
    m.ch.send(0)
    return m
}

impl Mutex {
    // Acquire the lock, blocking until it is free.
    fun lock(self) {
        let _ = self.ch.recv()
    }

    // Release the lock. Call only while holding it.
    fun unlock(self) {
        self.ch.send(0)
    }
}

// A wait group: wait for a set of goroutines to finish. `add` raises the
// outstanding count before spawning work, `done` lowers it as each finishes,
// and `wait` blocks until the count returns to zero.
class WaitGroup {
    id: int
}

// Create a wait group with a zero count.
fun wait_group() -> WaitGroup {
    return WaitGroup(id: raven_waitgroup_new())
}

impl WaitGroup {
    // Add `n` to the outstanding count (call before spawning the work).
    fun add(self, n: int) {
        raven_waitgroup_add(self.id, n)
    }

    // Mark one unit of work done (lower the count by one).
    fun done(self) {
        raven_waitgroup_add(self.id, -1)
    }

    // Block until the count reaches zero.
    fun wait(self) {
        raven_waitgroup_wait(self.id)
    }

    // Release the wait group's runtime registry entry. Call when done to avoid
    // leaking the entry; there is no destructor.
    fun free(self) {
        raven_waitgroup_free(self.id)
    }
}

// The outcome of a `select_recv`: `index` is the position in the channel list
// of the channel that produced a value (or -1 if the list was empty), and
// `value` is that value.
class SelectResult {
    index: int
    value: int
}

// Block until one of `channels` has a value to receive, then return its index
// in the list and the value. When several are ready the lowest index wins.
fun select_recv(channels: list[Channel]) -> SelectResult {
    let set = raven_select_new()
    for ch in channels {
        raven_select_add(set, ch.id)
    }
    let index = raven_select_recv(set)
    let value = raven_select_value()
    raven_select_free(set)
    return SelectResult(index: index, value: value)
}
