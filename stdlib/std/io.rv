// std.io: standard input and output. The `__io_*` intrinsics are lowered
// by the compiler to the raven-runtime C ABI symbols.

extern "C" {
    fun raven_io_is_terminal(fd: int) -> bool
}

// Whether standard output is a terminal, not a pipe or a file. Use it to
// decide whether to emit colors or interactive prompts.
fun is_terminal() -> bool {
    return raven_io_is_terminal(1)
}

// Whether standard input is a terminal.
fun stdin_is_terminal() -> bool {
    return raven_io_is_terminal(0)
}

fun print(s: str) {
    __io_print_str(s)
}

fun println(s: str) {
    __io_println_str(s)
}

// Print `prompt` with no trailing newline, then read one line from stdin
// without its newline. Empty at end of input.
fun input(prompt: str) -> str {
    __io_print_str(prompt)
    __io_read_line()
}

// Read one line from stdin without its newline. Empty at end of input.
fun read_line() -> str {
    __io_read_line()
}
