// std.encoding: hex and standard base64 over the bytes of a str.
// Raven str is a byte buffer; input is treated as raw bytes. See
// docs/guide/stdlib/encoding.md.

import std.error

extern "C" {
    fun raven_hex_encode(s: str) -> str
    fun raven_base64_encode(s: str) -> str
    fun raven_url_encode(s: str) -> str
}

// An Error tagged with kind "encoding". The struct literal is built directly:
// a bundled module cannot call another bundled module's free helpers.
fun encoding_error(msg: str) -> Error {
    return Error(kind: "encoding", message: msg)
}

// Map a hex digit byte (0-9, a-f, A-F) to its 0..15 value. Any other
// byte maps to 0.
fun hex_value(b: int) -> int {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    return -1
}

fun hex_encode(s: str) -> str {
    return raven_hex_encode(s)
}

// Inverse of hex_encode. An odd length, or any non-hex byte, is an Err rather
// than silently producing wrong output.
fun hex_decode(s: str) -> Result[str, Error] {
    let n = __str_len(s)
    if n % 2 != 0 {
        return Err(encoding_error("hex input has an odd length"))
    }
    let out: list[str] = []
    var i = 0
    while i < n {
        let hi = hex_value(__str_byte_at(s, i))
        let lo = hex_value(__str_byte_at(s, i + 1))
        if hi < 0 or lo < 0 {
            return Err(encoding_error("hex input has a non-hex character"))
        }
        out.push(__str_from_byte((hi << 4) | lo))
        i = i + 2
    }
    return Ok("".join(out))
}

// Map a base64 alphabet byte to its 0..63 value. Any other byte
// (including padding) maps to 0; callers track padding separately.
fun b64_value(b: int) -> int {
    if b >= 65 {
        if b <= 90 {
            return b - 65
        }
    }
    if b >= 97 {
        if b <= 122 {
            return b - 71
        }
    }
    if b >= 48 {
        if b <= 57 {
            return b + 4
        }
    }
    if b == 43 {
        return 62
    }
    if b == 47 {
        return 63
    }
    return -1
}

fun base64_encode(s: str) -> str {
    return raven_base64_encode(s)
}

// Inverse of base64_encode. The length must be a multiple of 4, trailing `=`
// is padding, and any other non-alphabet byte is an Err rather than silently
// contributing a wrong value.
fun base64_decode(s: str) -> Result[str, Error] {
    let n = __str_len(s)
    if n % 4 != 0 {
        return Err(encoding_error("base64 input length is not a multiple of 4"))
    }
    let out: list[str] = []
    var i = 0
    while i + 4 <= n {
        let c0 = __str_byte_at(s, i)
        let c1 = __str_byte_at(s, i + 1)
        let c2 = __str_byte_at(s, i + 2)
        let c3 = __str_byte_at(s, i + 3)
        let v0 = b64_value(c0)
        let v1 = b64_value(c1)
        let v2 = b64_value(c2)
        let v3 = b64_value(c3)
        // The first two bytes must be alphabet; the last two may be `=` padding.
        if v0 < 0 or v1 < 0 {
            return Err(encoding_error("base64 input has a non-alphabet character"))
        }
        if c2 != 61 and v2 < 0 {
            return Err(encoding_error("base64 input has a non-alphabet character"))
        }
        if c3 != 61 and v3 < 0 {
            return Err(encoding_error("base64 input has a non-alphabet character"))
        }
        // Padding (`=`) is valid only in the final group, and a pad in the third
        // position requires one in the fourth too (`XY==`, never `X=Z=`).
        if c2 == 61 or c3 == 61 {
            if i + 4 != n {
                return Err(encoding_error("base64 padding before the final group"))
            }
            if c2 == 61 and c3 != 61 {
                return Err(encoding_error("base64 padding is malformed"))
            }
        }
        let o0 = ((v0 << 2) | (v1 >> 4)) & 255
        out.push(__str_from_byte(o0))
        if c2 != 61 {
            let o1 = (((v1 & 15) << 4) | (v2 >> 2)) & 255
            out.push(__str_from_byte(o1))
        }
        if c2 != 61 {
            if c3 != 61 {
                let o2 = (((v2 & 3) << 6) | v3) & 255
                out.push(__str_from_byte(o2))
            }
        }
        i = i + 4
    }
    return Ok("".join(out))
}

// Percent-encode every byte that is not RFC 3986 unreserved, using uppercase
// hex (a space becomes "%20", not "+").
fun url_encode(s: str) -> str {
    return raven_url_encode(s)
}

// Decode "%XX" percent escapes back to bytes. The inverse of `url_encode`. A
// "+" is left as a literal plus.
fun url_decode(s: str) -> str {
    let n = __str_len(s)
    let out: list[str] = []
    var i = 0
    while i < n {
        let b = __str_byte_at(s, i)
        if b == 37 {
            if i + 2 < n {
                let hi = hex_value(__str_byte_at(s, i + 1))
                let lo = hex_value(__str_byte_at(s, i + 2))
                if hi < 0 or lo < 0 {
                    // Not a valid `%XX` escape: keep the `%` as a literal byte.
                    out.push(__str_from_byte(b))
                    i = i + 1
                } else {
                    out.push(__str_from_byte(hi * 16 + lo))
                    i = i + 3
                }
            } else {
                out.push(__str_from_byte(b))
                i = i + 1
            }
        } else {
            out.push(__str_from_byte(b))
            i = i + 1
        }
    }
    return "".join(out)
}

// Map a 0..31 value to its RFC 4648 base32 character (A-Z, 2-7).
fun base32_char(v: int) -> int {
    if v < 26 {
        return 65 + v
    }
    return 50 + (v - 26)
}

// Map a base32 character to its 0..31 value (accepts lowercase), or -1.
fun base32_value(b: int) -> int {
    if b >= 65 {
        if b <= 90 {
            return b - 65
        }
    }
    if b >= 97 {
        if b <= 122 {
            return b - 97
        }
    }
    if b >= 50 {
        if b <= 55 {
            return b - 50 + 26
        }
    }
    return -1
}

// RFC 4648 base32 encoding with "=" padding.
fun base32_encode(s: str) -> str {
    let n = __str_len(s)
    let out: list[str] = []
    var i = 0
    while i < n {
        var count = 0
        var acc = 0
        var k = 0
        while k < 5 {
            acc = acc << 8
            if i + k < n {
                acc = acc | __str_byte_at(s, i + k)
                count = count + 1
            }
            k = k + 1
        }
        var out_chars = 8
        if count == 1 {
            out_chars = 2
        }
        if count == 2 {
            out_chars = 4
        }
        if count == 3 {
            out_chars = 5
        }
        if count == 4 {
            out_chars = 7
        }
        var j = 0
        while j < 8 {
            if j < out_chars {
                let shift = 35 - j * 5
                let v = (acc >> shift) & 31
                out.push(__str_from_byte(base32_char(v)))
            } else {
                out.push("=")
            }
            j = j + 1
        }
        i = i + 5
    }
    return "".join(out)
}

// Inverse of base32_encode. Trailing `=` is padding; any other non-alphabet
// byte is an Err rather than being silently skipped.
fun base32_decode(s: str) -> Result[str, Error] {
    let n = __str_len(s)
    // base32_encode always pads to a multiple of 8, so a different length is a
    // truncated (partial) group rather than valid input.
    if n % 8 != 0 {
        return Err(encoding_error("base32 input length is not a multiple of 8"))
    }
    let out: list[str] = []
    var acc = 0
    var bits = 0
    var seen_pad = false
    var pad_count = 0
    var i = 0
    while i < n {
        let b = __str_byte_at(s, i)
        if b == 61 {
            // `=` padding: no more data bits follow, and nothing may come after.
            seen_pad = true
            pad_count = pad_count + 1
        } else {
            if seen_pad {
                return Err(encoding_error("base32 data after padding"))
            }
            let v = base32_value(b)
            if v < 0 {
                return Err(encoding_error("base32 input has a non-alphabet character"))
            }
            acc = (acc << 5) | v
            bits = bits + 5
            if bits >= 8 {
                bits = bits - 8
                let byte = (acc >> bits) & 255
                out.push(__str_from_byte(byte))
            }
        }
        i = i + 1
    }
    if pad_count != 0 and pad_count != 1 and pad_count != 3 and pad_count != 4 and pad_count != 6 {
        return Err(encoding_error("base32 padding is malformed"))
    }
    return Ok("".join(out))
}

// URL-safe base64 (RFC 4648 section 5) without padding, as JWT and URL
// tokens use: `-` and `_` instead of `+` and `/`, and no trailing `=`.
fun base64url_encode(s: str) -> str {
    let std64 = base64_encode(s)
    let out: list[str] = []
    var i = 0
    let n = __str_len(std64)
    while i < n {
        let b = __str_byte_at(std64, i)
        if b == 43 {
            out.push("-")
        } else if b == 47 {
            out.push("_")
        } else if b != 61 {
            out.push(__str_from_byte(b))
        }
        i = i + 1
    }
    return "".join(out)
}

// Decode URL-safe base64, with or without `=` padding.
fun base64url_decode(s: str) -> Result[str, Error] {
    let out: list[str] = []
    var i = 0
    let n = __str_len(s)
    while i < n {
        let b = __str_byte_at(s, i)
        if b == 45 {
            out.push("+")
        } else if b == 95 {
            out.push("/")
        } else if b == 43 or b == 47 {
            return Err(encoding_error("base64url input contains `+` or `/`"))
        } else {
            out.push(__str_from_byte(b))
        }
        i = i + 1
    }
    var padded = "".join(out)
    while __str_len(padded) % 4 != 0 {
        padded = padded + "="
    }
    return base64_decode(padded)
}
