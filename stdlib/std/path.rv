// std.path: POSIX-style path manipulation on `/` separators. Built on the
// `str` methods from std.string. Windows `\` handling is out of scope.

import std.string

// Byte index of the last `/`, or -1 when none.
fun last_slash(p: str) -> int {
    var i = p.length() - 1
    while i >= 0 {
        if p.char_at(i).starts_with("/") {
            return i
        }
        i = i - 1
    }
    return -1
}

fun join(a: str, b: str) -> str {
    if a.length() == 0 {
        return b
    }
    if b.length() == 0 {
        return a
    }
    let a_slash = a.ends_with("/")
    let b_slash = b.starts_with("/")
    if a_slash {
        if b_slash {
            return a.concat(b.substring(1, b.length()))
        }
        return a.concat(b)
    }
    if b_slash {
        return a.concat(b)
    }
    return a.concat("/").concat(b)
}

fun basename(p: str) -> str {
    var i = last_slash(p)
    if i < 0 {
        return p
    }
    return p.substring(i + 1, p.length())
}

fun dirname(p: str) -> str {
    var i = last_slash(p)
    if i < 0 {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return p.substring(0, i)
}

// Substring after the last `.` in the basename, or "" when none. A leading
// dot (a dotfile such as ".gitignore") is not an extension.
fun extension(p: str) -> str {
    let base = basename(p)
    let n = base.length()
    var i = n - 1
    while i > 0 {
        if base.char_at(i).starts_with(".") {
            return base.substring(i + 1, n)
        }
        i = i - 1
    }
    return ""
}

fun stem(p: str) -> str {
    let base = basename(p)
    let n = base.length()
    var i = n - 1
    while i > 0 {
        if base.char_at(i).starts_with(".") {
            return base.substring(0, i)
        }
        i = i - 1
    }
    return base
}

fun is_absolute(p: str) -> bool {
    return p.starts_with("/")
}

fun is_relative(p: str) -> bool {
    return is_absolute(p) == false
}

// The non-empty path segments, in order. Leading, trailing, and repeated
// slashes produce no empty components.
fun components(p: str) -> list[str] {
    let out: list[str] = []
    for seg in p.split("/") {
        if seg.length() > 0 {
            out.push(seg)
        }
    }
    return out
}

// Collapse `.` and `..` segments and redundant slashes. An absolute path
// keeps its leading `/`; an empty relative result becomes ".".
fun normalize(p: str) -> str {
    let abs = is_absolute(p)
    let stack: list[str] = []
    for seg in p.split("/") {
        if seg.length() == 0 {
            continue
        }
        if seg == "." {
            continue
        }
        if stack.len() > 0 {
            let top = stack.get(stack.len() - 1)
            if top == ".." {
                stack.push(seg)
            } else {
                let _popped = stack.pop()
            }
        } else {
            if abs == false {
                stack.push(seg)
            }
        } if seg == ".." else stack.push(seg)
    }
    var result = ""
    var i = 0
    while i < stack.len() {
        if i > 0 {
            result = result.concat("/")
        }
        result = result.concat(stack.get(i))
        i = i + 1
    }
    if abs {
        return "/".concat(result)
    }
    if result.length() == 0 {
        return "."
    }
    return result
}

// Replace the path's extension with `ext` (no leading dot). An empty `ext`
// removes the extension.
fun with_extension(p: str, ext: str) -> str {
    let base = basename(p)
    let n = base.length()
    let prefix = p.length() - n
    var i = n - 1
    while i > 0 {
        if base.char_at(i).starts_with(".") {
            let without = p.substring(0, prefix + i)
            if ext.length() == 0 {
                return without
            }
            return without.concat(".").concat(ext)
        }
        i = i - 1
    }
    if ext.length() == 0 {
        return p
    }
    return p.concat(".").concat(ext)
}

// A path as a value, like Python's pathlib.Path: `Path.new("data").join("a.txt")`.
// Methods that touch the disk live in std.fs; this class only works on the
// text, so it is safe to build paths that do not exist yet.
class Path {
    text: str
}

impl Path {
    fun new(text: str) -> Path = Path(text: text)

    fun join(self, part: str) -> Path = Path(text: join(self.text, part))

    // The parent directory.
    fun parent(self) -> Path = Path(text: dirname(self.text))

    // The last component: `report.tar.gz`.
    fun name(self) -> str = basename(self.text)

    // The name without its last extension: `report.tar`.
    fun stem(self) -> str = stem(self.text)

    // The last extension without the dot: `gz`, or "".
    fun extension(self) -> str = extension(self.text)

    fun with_extension(self, ext: str) -> Path = Path(text: with_extension(self.text, ext))

    fun with_name(self, name: str) -> Path = Path(text: join(dirname(self.text), name))

    fun components(self) -> list[str] = components(self.text)

    fun normalize(self) -> Path = Path(text: normalize(self.text))

    fun is_absolute(self) -> bool = is_absolute(self.text)
}

impl ToString for Path {
    fun to_string(self) -> str = self.text
}

impl Eq for Path {
    fun equals(self, other: Path) -> bool = normalize(self.text) == normalize(other.text)
}
