// std.http: an HTTP/1.1 client over the raven-runtime C ABI, backed by
// ureq. A ureq Response is consumed when its body is read, so the whole
// request runs in one runtime call that eagerly captures the status,
// reason, headers, and body into a registry entry keyed by an opaque
// integer id; the extractors then read that entry by id. A non-2xx HTTP
// status (404, 500) is a successful request that yielded a response, not
// a transport error: only DNS, connect, and timeout failures take the Err
// path through the runtime's thread-local last-error slot, tagged with
// kind "http". See docs/guide/stdlib/http.md.

from std.error import error_kind
from std.net import listen, connect, TcpStream
import std.string
from std.fmt import from_radix
import std.collections
from std.json import JsonValue, ToJson, FromJson, stringify, parse, decode
from std.fs import is_symlink, read
from std.sync import mutex, wait_group, Mutex
from std.encoding import url_decode

class HttpResponse {
    status_code: int
    status_text: str
    // Response headers as `Key: Value` lines joined by `\n`.
    headers: str
    body: str
}

extern "C" {
    fun raven_http_last_error() -> str
    fun raven_http_request(method: str, url: str, body: str, headers: str) -> int
    fun raven_http_request_timeout(method: str, url: str, body: str, headers: str, timeout_ms: int) -> int
    fun raven_http_status(id: int) -> int
    fun raven_http_status_text(id: int) -> str
    fun raven_http_body(id: int) -> str
    fun raven_http_header(id: int, name: str) -> str
    fun raven_http_headers(id: int) -> str
    fun raven_http_free(id: int)
    fun raven_http_stream_open(method: str, url: str, body: str, headers: str, timeout_ms: int) -> int
    fun raven_http_stream_read(id: int) -> str
    fun raven_http_stream_status(id: int) -> int
    fun raven_http_stream_status_text(id: int) -> str
    fun raven_http_stream_headers(id: int) -> str
    fun raven_http_stream_close(id: int)
}

// An Error tagged with kind "http", its message a context prefix joined to
// the runtime's last-error text.
fun http_error(ctx: str) -> Error {
    return error_kind("http", ctx.concat(": ").concat(raven_http_last_error()))
}

// Run a request and assemble an HttpResponse, or an Err on transport
// failure. The headers argument is `Key: Value` lines joined by `\n`, or
// "" for none. A non-2xx HTTP status is still Ok: the runtime reports it
// as a normal response.
fun request(method: str, url: str, body: str, headers: str) -> Result[HttpResponse, Error] {
    return _collect(raven_http_request(method, url, body, headers), method)
}

// Like request, with an overall deadline: a positive timeout_ms bounds the
// whole request (connect, send, and reading the body), and a timeout
// surfaces as an Err like any other transport failure. timeout_ms <= 0
// keeps the default timeouts. Use this for endpoints that take longer than
// the defaults allow, for example model inference APIs.
fun request_with_timeout(
    method: str,
    url: str,
    body: str,
    headers: str,
    timeout_ms: int,
) -> Result[HttpResponse, Error] {
    return _collect(raven_http_request_timeout(method, url, body, headers, timeout_ms), method)
}

// Assemble the stored response `id` into an HttpResponse and release it.
fun _collect(id: int, ctx: str) -> Result[HttpResponse, Error] {
    if id == 0 {
        return Err(http_error(ctx))
    }
    if raven_http_last_error().length() > 0 {
        return Err(http_error(ctx))
    }
    let resp = HttpResponse(
        status_code: raven_http_status(id),
        status_text: raven_http_status_text(id),
        headers: raven_http_headers(id),
        body: raven_http_body(id),
    )
    raven_http_free(id)
    return Ok(resp)
}

// GET `url`.
fun get(url: str) -> Result[HttpResponse, Error] {
    return request("GET", url, "", "")
}

// POST `body` to `url`.
fun post(url: str, body: str) -> Result[HttpResponse, Error] {
    return request("POST", url, body, "")
}

// PUT `body` to `url`.
fun put(url: str, body: str) -> Result[HttpResponse, Error] {
    return request("PUT", url, body, "")
}

// DELETE `url`.
fun delete(url: str) -> Result[HttpResponse, Error] {
    return request("DELETE", url, "", "")
}

// PATCH `body` to `url`.
fun patch(url: str, body: str) -> Result[HttpResponse, Error] {
    return request("PATCH", url, body, "")
}

// HEAD `url` (response carries headers and status but no body).
fun head(url: str) -> Result[HttpResponse, Error] {
    return request("HEAD", url, "", "")
}

// A streaming response: the status and headers arrive at open, the body is
// pulled chunk by chunk with read_chunk. This is how to consume server-sent
// events, chunked transfers, and any response too large or too slow to
// buffer whole. Close it when done; an ended stream still holds its status
// and headers until then.
class HttpStream {
    id: int
    status_code: int
    status_text: str
    // Response headers as `Key: Value` lines joined by `\n`.
    headers: str
}

// Open a streaming request. A positive timeout_ms bounds the connect and
// each body read individually (not the whole stream, which may stay open
// for as long as the server keeps sending); timeout_ms <= 0 keeps the
// defaults. A non-2xx status opens normally so the error body is readable;
// only a transport failure is an Err.
fun stream(
    method: str,
    url: str,
    body: str,
    headers: str,
    timeout_ms: int,
) -> Result[HttpStream, Error] {
    let id = raven_http_stream_open(method, url, body, headers, timeout_ms)
    if id == 0 {
        return Err(http_error(method))
    }
    if raven_http_last_error().length() > 0 {
        return Err(http_error(method))
    }
    return Ok(
        HttpStream(
            id: id,
            status_code: raven_http_stream_status(id),
            status_text: raven_http_stream_status_text(id),
            headers: raven_http_stream_headers(id),
        ),
    )
}

impl HttpStream {
    // The next chunk of the body: whatever the next socket read returns, at
    // most 8 KiB. Ok("") means the stream ended; a failed or timed-out read
    // is an Err. One read at a time per stream.
    fun read_chunk(self) -> Result[str, Error] {
        let chunk = raven_http_stream_read(self.id)
        if chunk.length() == 0 and raven_http_last_error().length() > 0 {
            return Err(http_error("stream read"))
        }
        return Ok(chunk)
    }

    // Release the stream and its connection. Reading after close observes
    // end of stream.
    fun close(self) {
        raven_http_stream_close(self.id)
    }
}

// ===========================================================================
// HTTP/1.1 server
//
// A small, dependency-free server built on std.net (TCP). Register handler
// functions on a `Server` by method and path pattern, then `listen`. Each
// connection is parsed into a `Request`, routed to the first matching handler,
// and the returned `Response` is written back. A path pattern may name captures
// with a `:name` segment, read in the handler with `req.param("name")`.
//
//     fun hello(req: Request) -> Response = Response.text("hi, ${req.param("who")}")
//
//     fun main() {
//         let app = Server.new()
//         app.get("/hello/:who", hello)
//         let _ = app.listen("127.0.0.1:8080")
//     }
// ===========================================================================

// The HTTP request method. `Unknown` stands for any method the server does not
// model explicitly; it never matches a registered route.
@derive(Eq, ToString)
enum Method {
    Get,
    Post,
    Put,
    Delete,
    Patch,
    Head,
    Options,
    Unknown,
}

// Parse a method token (case-insensitive) into a `Method`.
fun parse_method(s: str) -> Method {
    let u = s.to_upper()
    if u == "GET" {
        return Method.Get
    }
    if u == "POST" {
        return Method.Post
    }
    if u == "PUT" {
        return Method.Put
    }
    if u == "DELETE" {
        return Method.Delete
    }
    if u == "PATCH" {
        return Method.Patch
    }
    if u == "HEAD" {
        return Method.Head
    }
    if u == "OPTIONS" {
        return Method.Options
    }
    return Method.Unknown
}

// One parsed HTTP request. `headers` keys are lowercased; `params` holds the
// path captures matched from the route pattern; `query` holds the decoded
// query-string pairs.
class Request {
    method: Method
    path: str
    version: str
    headers: dict[str, str]
    params: dict[str, str]
    query: dict[str, str]
    body: str
    // Values middleware attaches for later handlers, such as the signed-in
    // user's id or a request id.
    context: dict[str, str]
}

impl Request {
    // A request header by name (case-insensitive), or "" if absent.
    fun header(self, name: str) -> str {
        return self.headers.get_or(name.to_lower(), "")
    }

    // A path capture (a `:name` segment) by name, or "" if absent.
    fun param(self, name: str) -> str {
        return self.params.get_or(name, "")
    }

    // A query-string value by name, or "" if absent.
    fun query_value(self, name: str) -> str {
        return self.query.get_or(name, "")
    }

    // Decode the request body into a `T` via its `FromJson` impl, for example
    // `req.json[User]()` or `let u: User = req.json()?`. Returns an Err for
    // malformed JSON or a body that does not match `T`.
    fun json[T: FromJson](self) -> Result[T, Error] {
        return decode(self.body)
    }

    // Parse the request body as JSON to a `JsonValue` for ad-hoc inspection,
    // when a struct is overkill. Returns an Err for malformed JSON.
    fun json_value(self) -> Result[JsonValue, Error] {
        return parse(self.body)
    }
}

// One HTTP response: a status code, response headers, and a body. Build one
// with a constructor (`Response.json`, `Response.not_found`, ...) and refine it
// with the chaining builders (`header`, `content_type`, `status_code`).
class Response {
    status: int
    headers: dict[str, str]
    body: str
}

impl Response {
    // A response with an explicit status and body and no headers yet.
    fun with_body(status: int, body: str) -> Response {
        let h: dict[str, str] = Map.new()
        return Response(status: status, headers: h, body: body)
    }

    // 200 with `value` serialized to JSON via its `ToJson` impl (a `@derive(
    // ToJson)` struct or enum, a list, an Option, or a scalar), with
    // `Content-Type: application/json`. Chain `.status_code(201)` for Created.
    fun json[T: ToJson](value: T) -> Response {
        return Response.with_body(200, stringify(value.to_json())).content_type("application/json")
    }

    // 200 serving the file at `path` from disk, with a `Content-Type` chosen
    // from its extension. A missing or unreadable file is a 404.
    fun file(path: str) -> Response {
        return match read(path) {
            case Ok(body) { Response.with_body(200, body).content_type(content_type_for(path)) }
            case Err(_) { Response.not_found() }
        }
    }

    // 200 with a `text/plain` body.
    fun text(body: str) -> Response {
        return Response.with_body(200, body).content_type("text/plain; charset=utf-8")
    }

    // 200 with a `text/plain` body (an alias of `text`).
    fun ok(body: str) -> Response {
        return Response.text(body)
    }

    // 200 with a `text/html` body.
    fun html(body: str) -> Response {
        return Response.with_body(200, body).content_type("text/html; charset=utf-8")
    }

    // 200 with `body` (already JSON text) and an `application/json` type. Use
    // `Response.json(value)` instead to serialize a value; this is for a body
    // you have already rendered.
    fun json_raw(body: str) -> Response {
        return Response.with_body(200, body).content_type("application/json")
    }

    // 201 Created with a `text/plain` body.
    fun created(body: str) -> Response {
        return Response.with_body(201, body).content_type("text/plain; charset=utf-8")
    }

    // 204 No Content.
    fun no_content() -> Response {
        return Response.with_body(204, "")
    }

    // 404 Not Found with a short plain-text body.
    fun not_found() -> Response {
        return Response.with_body(404, "Not Found").content_type("text/plain; charset=utf-8")
    }

    // 400 Bad Request with `msg` as the body.
    fun bad_request(msg: str) -> Response {
        return Response.with_body(400, msg).content_type("text/plain; charset=utf-8")
    }

    // 500 Internal Server Error with `msg` as the body.
    fun server_error(msg: str) -> Response {
        return Response.with_body(500, msg).content_type("text/plain; charset=utf-8")
    }

    // 302 Found, redirecting the client to `location`.
    fun redirect(location: str) -> Response {
        return Response.with_body(302, "").header("Location", location)
    }

    // Set a response header, returning self so calls chain. A name that is not a
    // valid HTTP field token (it has a space, control, or separator byte) is
    // dropped, and control bytes are stripped from the value (HTAB excepted).
    // Either would otherwise frame a malformed response or inject extra headers,
    // since CR/LF and other controls have meaning in the header block.
    fun header(self, name: str, value: str) -> Response {
        if not is_valid_field_name(name) {
            return self
        }
        self.headers.set(name, sanitize_field_value(value))
        return self
    }

    // Set the `Content-Type` header, returning self so calls chain.
    fun content_type(self, value: str) -> Response {
        return self.header("Content-Type", value)
    }

    // Replace the status code, returning self so calls chain.
    fun status_code(self, code: int) -> Response {
        self.status = code
        return self
    }
}

// One registered route: a method, a path pattern (with optional `:name`
// captures), and the handler to run on a match.
class Route {
    method: Method
    pattern: str
    handler: fun(Request) -> Response
}

// An HTTP server: a routing table built with `get`/`post`/... and served with
// `listen`. `access_log` is off by default; enable it with `with_access_log`.
// `read_timeout_ms` and `write_timeout_ms` bound how long a single slow client
// can hold a connection (0 disables); they default to 30 seconds so an idle or
// slow client cannot pin a goroutine forever. `lock`/`stopping`/`addr` back
// graceful shutdown.
class Server {
    routes: list[Route]
    access_log: bool
    read_timeout_ms: int
    write_timeout_ms: int
    lock: Mutex
    stopping: bool
    addr: str
    middleware: list[fun(Request, fun(Request) -> Response) -> Response]
    max_body: int
    gzip: bool
}

impl Server {
    // A new server with an empty routing table, the access log off, and 30
    // second read and write timeouts.
    fun new() -> Server {
        let r: list[Route] = []
        return Server(
            routes: r,
            access_log: false,
            read_timeout_ms: 30000,
            write_timeout_ms: 30000,
            lock: mutex(),
            stopping: false,
            addr: "",
            middleware: [],
            max_body: 10485760,
            gzip: false,
        )
    }

    // Request a graceful shutdown: stop accepting new connections, let the
    // requests already in flight finish, then `listen` returns. Call it from
    // another goroutine or from a handler, since `listen` blocks. Safe to call
    // more than once.
    fun shutdown(self) {
        self.lock.lock()
        self.stopping = true
        self.lock.unlock()
        // The runtime's `accept` blocks on a cloned listener handle and cannot
        // be cancelled, so nudge it with a throwaway local connection: the
        // accept loop then sees the stopping flag and drops it without serving.
        match connect(wakeup_addr(self.addr)) {
            case Ok(s) { s.close() }
            case Err(_) {}
        }
    }

    // Whether a graceful shutdown has been requested. Read under the lock so the
    // accept loop and the goroutine calling `shutdown` agree.
    fun is_stopping(self) -> bool {
        self.lock.lock()
        let s = self.stopping
        self.lock.unlock()
        return s
    }

    // Enable a one-line-per-request access log to stdout (method, path, and
    // status code, for example `GET /tasks 200`), returning self so it chains:
    // `let app = Server.new().with_access_log()`. Logging happens at the single
    // point every request passes through, so it covers every route without a
    // line in each handler.
    fun with_access_log(self) -> Server {
        self.access_log = true
        return self
    }

    // Set the read and write timeouts to `seconds` each, returning self so it
    // chains. `0` (or a negative value) disables both (a request or response may
    // then block forever on a slow client). A read timeout bounds how long the
    // server waits for the client to send its request; a write timeout bounds
    // sending the response. The default is 30 seconds.
    fun with_timeout(self, seconds: int) -> Server {
        let ms = timeout_ms(seconds)
        self.read_timeout_ms = ms
        self.write_timeout_ms = ms
        return self
    }

    // Set only the read timeout, in seconds (`0` disables it). See `with_timeout`.
    fun with_read_timeout(self, seconds: int) -> Server {
        self.read_timeout_ms = timeout_ms(seconds)
        return self
    }

    // Set only the write timeout, in seconds (`0` disables it). See `with_timeout`.
    fun with_write_timeout(self, seconds: int) -> Server {
        self.write_timeout_ms = timeout_ms(seconds)
        return self
    }

    // Register `handler` for `method` requests whose path matches `pattern`.
    // Routes are tried in registration order; the first match wins.
    // Wrap every request in `mw`, which receives the request and `next` (the
    // rest of the chain) and returns the response. Middleware runs in the
    // order it was added, outermost first, before routing; it can answer on
    // its own (an auth check returning 401), change the request, or change
    // the response `next` returns.
    fun use(self, mw: fun(Request, fun(Request) -> Response) -> Response) {
        self.middleware.push(mw)
    }

    // Refuse request bodies over `bytes` with 413 Payload Too Large. The
    // default is 10 MiB.
    fun with_max_body(self, bytes: int) -> Server {
        self.max_body = bytes
        return self
    }

    // gzip text, JSON, JavaScript, and SVG responses of 1 KiB or more for
    // clients that accept it.
    fun with_gzip(self) -> Server {
        self.gzip = true
        return self
    }

    fun route(self, method: Method, pattern: str, handler: fun(Request) -> Response) {
        self.routes.push(Route(method: method, pattern: pattern, handler: handler))
    }

    // Register a handler for GET `pattern`.
    fun get(self, pattern: str, handler: fun(Request) -> Response) {
        self.route(Method.Get, pattern, handler)
    }

    // Register a handler for POST `pattern`.
    fun post(self, pattern: str, handler: fun(Request) -> Response) {
        self.route(Method.Post, pattern, handler)
    }

    // Register a handler for PUT `pattern`.
    fun put(self, pattern: str, handler: fun(Request) -> Response) {
        self.route(Method.Put, pattern, handler)
    }

    // Register a handler for DELETE `pattern`.
    fun delete(self, pattern: str, handler: fun(Request) -> Response) {
        self.route(Method.Delete, pattern, handler)
    }

    // Register a handler for PATCH `pattern`.
    fun patch(self, pattern: str, handler: fun(Request) -> Response) {
        self.route(Method.Patch, pattern, handler)
    }

    // Serve files under directory `dir` for GET requests whose path starts with
    // `prefix`: `app.static("/static", "public")` serves `GET
    // /static/img/logo.svg` from `public/img/logo.svg`. Parent references,
    // backslashes, and drive markers are refused, so a request cannot leave
    // `dir`. A missing file is a 404 (see `Response.file`).
    fun static(self, prefix: str, dir: str) {
        var p = prefix
        while p.ends_with("/") {
            p = p.substring(0, p.length() - 1)
        }
        self.route(
            Method.Get,
            p.concat("/*file"),
            (req: Request) -> Response => serve_from(dir, req),
        )
    }

    // Bind `addr` ("host:port") and serve, handling each connection on its own
    // goroutine so a slow client never blocks the others. Blocks until
    // `shutdown` is called, after which it stops accepting, waits for in-flight
    // requests to finish, and returns. A failed bind is reported and returns.
    fun listen(self, addr: str) {
        self.addr = addr
        match listen(addr) {
            case Ok(socket) {
                // Track in-flight connection goroutines so a graceful shutdown
                // can wait for them to drain before returning.
                let inflight = wait_group()
                while not self.is_stopping() {
                    match socket.accept() {
                        case Ok(stream) {
                            // A connection accepted after shutdown began (a real
                            // late arrival or the wakeup nudge) is dropped, not
                            // served: only already-accepted requests drain.
                            if self.is_stopping() {
                                stream.close()
                            } else {
                                inflight.add(1)
                                spawn {
                                    serve_connection(self, stream)
                                    inflight.done()
                                }
                            }
                        }
                        case Err(_) {}
                    }
                }
                inflight.wait()
                // Release the listening socket so the port is free after a
                // graceful shutdown returns, rather than staying bound.
                socket.close()
            }
            case Err(e) { print("http: cannot bind ".concat(addr).concat(": ").concat(e.message())) }
        }
    }
}

// Serve one connection: read a request, route it, write the response, and
// repeat on the same connection while keep-alive is in effect, then close it.
// The read and write timeouts are applied to the stream first, so a slow client
// cannot hold the goroutine open indefinitely. The connection is kept alive
// for the next request unless the client asked to close it, the server is
// shutting down, or the request could not be read. When the access log is on,
// each served request prints its method, path, and status.
fun serve_connection(server: Server, stream: TcpStream) {
    if server.read_timeout_ms > 0 {
        stream.set_read_timeout_ms(server.read_timeout_ms)
    }
    if server.write_timeout_ms > 0 {
        stream.set_write_timeout_ms(server.write_timeout_ms)
    }
    var open = true
    var served = 0
    var carry = ""
    while open {
        match read_request(stream, carry, server.max_body) {
            case Ok(maybe) {
                match maybe {
                    case Some(parsed) {
                        carry = parsed.rest
                        let req = parsed.request
                        var resp = _run_chain(server, 0, req)
                        if server.gzip {
                            resp = _maybe_gzip(req, resp)
                        }
                        var keep = should_keep_alive(req)
                        if server.is_stopping() {
                            keep = false
                        }
                        let is_head = match req.method {
                            case Head { true }
                            case _ { false }
                        }
                        write_response(stream, resp, keep, is_head)
                        if server.access_log {
                            let method = req.method.to_string().to_upper()
                            // Log the sanitized status that went on the wire, not
                            // the raw handler value, so the log matches what the
                            // client received.
                            print("${method} ${req.path} ${sanitize_status(resp.status)}")
                        }
                        served += 1
                        if not keep {
                            open = false
                        }
                    }
                    // A clean close with no request pending: an idle keep-alive
                    // client hung up. Close silently.
                    case None {
                        open = false
                    }
                }
            }
            case Err(e) {
                // A malformed request is answered with 400 (413 for a body over
                // the limit) whether or not earlier requests on this keep-alive
                // connection succeeded; only a clean idle hang-up (Ok(None)
                // above) closes silently.
                let too_large = e.message.contains("too large")
                var resp = Response.with_body(413, "Payload Too Large") if too_large else Response.bad_request("Bad Request")
                write_response(stream, resp, false, false)
                // Closing while the client is still sending makes the OS reset
                // the connection, and the client sees the reset instead of
                // this response. Read and discard what is left first.
                drain(stream)
                if server.access_log {
                    print("- - ${resp.status}")
                }
                open = false
            }
        }
    }
    stream.close()
}

// Whether the `Connection` header value carries `token` as one of its
// comma-separated options, compared after trimming each. The whole value cannot
// be compared directly: `keep-alive, close` lists two options, and a `close`
// beside another option must still be honored.
// Read and discard a client's remaining upload, up to 64 MiB or until it goes
// quiet for half a second, so a close after an error response is clean.
fun drain(stream: TcpStream) {
    stream.set_read_timeout_ms(500)
    var total = 0
    while total < 67108864 {
        match stream.read(65536) {
            case Ok(chunk) {
                if chunk.length() == 0 {
                    return
                }
                total += chunk.length()
            }
            case Err(_) {
                return
            }
        }
    }
}

fun connection_has_token(conn: str, token: str) -> bool {
    let parts = conn.split(",")
    var i = 0
    while i < parts.len() {
        if parts[i].trim() == token {
            return true
        }
        i += 1
    }
    return false
}

// Whether to keep the connection open for another request. HTTP/1.1 keeps it
// open unless the client sent a `close` option; HTTP/1.0 closes it unless the
// client sent a `keep-alive` option. The `Connection` header is a list of
// tokens, so each is checked individually.
fun should_keep_alive(req: Request) -> bool {
    let conn = req.header("connection").to_lower()
    if req.version == "HTTP/1.0" {
        return connection_has_token(conn, "keep-alive")
    }
    return not connection_has_token(conn, "close")
}

// A connectable address for the shutdown wakeup. A server bound to the
// wildcard `0.0.0.0` (or an empty host) is not reachable by that address, but
// its port is reachable on loopback; a concrete bound host is reachable as is.
fun wakeup_addr(addr: str) -> str {
    // An IPv6 address is bracketed (`[host]:port`), and its host part itself
    // contains colons, so the IPv4 split on the first colon does not apply. A
    // wildcard `[::]` (or `[::0]`) is not connectable, so rewrite it to the IPv6
    // loopback `[::1]`, which the wildcard listener accepts.
    if addr.starts_with("[") {
        let close = addr.index_of("]")
        if close < 0 {
            return addr
        }
        let host = addr.substring(1, close)
        let port = addr.substring(close + 1, addr.length())
        if host == "::" or host == "::0" or host == "0:0:0:0:0:0:0:0" {
            return "[::1]".concat(port)
        }
        return addr
    }
    let colon = addr.index_of(":")
    if colon < 0 {
        return addr
    }
    let host = addr.substring(0, colon)
    let port = addr.substring(colon, addr.length())
    if host == "0.0.0.0" or host == "" {
        return "127.0.0.1".concat(port)
    }
    return addr
}

// Find the first route matching `req` and run its handler; 404 if none match.
fun dispatch(routes: list[Route], req: Request) -> Response {
    var i = 0
    while i < routes.len() {
        let route = routes[i]
        if route.method == req.method {
            match match_path(route.pattern, req.path) {
                case Some(params) {
                    req.params = params
                    let handler = route.handler
                    return handler(req)
                }
                case None {}
            }
        }
        i += 1
    }
    return Response.not_found()
}

// Match a route `pattern` against a request `path`, returning the captured
// `:name` segments on success.
fun match_path(pattern: str, path: str) -> Option[dict[str, str]] {
    let pat = path_segments(pattern)
    let got = path_segments(path)
    let wildcard = pat.len() > 0 and pat[pat.len() - 1].starts_with("*")
    if wildcard {
        if got.len() < pat.len() {
            return None
        }
    } else if pat.len() != got.len() {
        return None
    }
    let params: dict[str, str] = Map.new()
    var i = 0
    while i < pat.len() {
        let p = pat[i]
        let g = got[i]
        if p.starts_with("*") {
            // A `*name` segment captures the rest of the path, slashes and all.
            params.set(p.substring(1, p.length()), "/".join(got.slice(i, got.len())))
            return Some(params) if got.len() > i else None
        }
        if p.starts_with(":") {
            params.set(p.substring(1, p.length()), g)
        } else {
            if p != g {
                return None
            }
        }
        i += 1
    }
    return Some(params)
}

// Split a path on "/" into its non-empty segments.
fun path_segments(path: str) -> list[str] {
    let raw = path.split("/")
    var out: list[str] = []
    var i = 0
    while i < raw.len() {
        if raw[i].length() > 0 {
            out.push(raw[i])
        }
        i += 1
    }
    return out
}

// Read one HTTP request off `stream`: the header block up to the first blank
// line, then the body up to the request's Content-Length.
// One parsed request plus any bytes read past its body, which belong to the
// next (pipelined) request on a kept-alive connection.
class ReadResult {
    request: Request
    rest: str
}

// A decoded chunked body plus any bytes read past the final chunk (the start of
// the next pipelined request).
class ChunkedBody {
    body: str
    rest: str
}

// Decode a `Transfer-Encoding: chunked` body, beginning from `initial` (the
// bytes already read after the headers) and reading more from `stream` as
// needed. Each chunk is `<hex-size>[;ext]\r\n[data]\r\n`; a zero-size chunk
// ends the body, followed by optional trailer lines and a final blank line.
fun is_chunked_only(te: str) -> bool {
    let parts = te.split(",")
    if parts.len() != 1 {
        return false
    }
    return parts[0].trim().to_lower() == "chunked"
}

fun decode_chunked(stream: TcpStream, initial: str, max_body: int) -> Result[ChunkedBody, Error] {
    var buf = initial
    var decoded = ""
    var total = 0
    // A single chunk-size line or the whole trailer block must fit this, so an
    // oversized extension or trailer cannot force unbounded buffering.
    let max_frame = 65536
    var done = false
    while not done {
        // Read up to the end of the chunk-size line.
        var nl = buf.index_of("\r\n")
        while nl < 0 {
            if buf.length() > max_frame {
                return Err(error_kind("http", "chunk size line too large"))
            }
            let chunk = stream.read(4096)?
            if chunk.length() == 0 {
                return Err(error_kind("http", "connection closed in chunk size"))
            }
            buf = buf.concat(chunk)
            nl = buf.index_of("\r\n")
        }
        var size_line = buf.substring(0, nl)
        // A chunk extension follows the size after a `;`; ignore it.
        let semi = size_line.index_of(";")
        if semi >= 0 {
            size_line = size_line.substring(0, semi)
        }
        // A chunk size is one or more hex digits, nothing else: reject a leading
        // sign or any surrounding whitespace (`+a`, ` a`, `a `) rather than
        // trimming it away and accepting it.
        if not is_hex_digits(size_line) {
            return Err(error_kind("http", "invalid chunk size"))
        }
        var size = 0
        match from_radix(size_line, 16) {
            case Some(n) {
                size = n
            }
            case None {
                return Err(error_kind("http", "invalid chunk size"))
            }
        }
        if size < 0 {
            return Err(error_kind("http", "negative chunk size"))
        }
        buf = buf.substring(nl + 2, buf.length())
        if size == 0 {
            // Final chunk: consume any trailer lines up to the blank line.
            done = true
            var stop = false
            while not stop {
                let tnl = buf.index_of("\r\n")
                if tnl == 0 {
                    buf = buf.substring(2, buf.length())
                    stop = true
                } else if tnl > 0 {
                    buf = buf.substring(tnl + 2, buf.length())
                } else {
                    if buf.length() > max_frame {
                        return Err(error_kind("http", "chunk trailer too large"))
                    }
                    let chunk = stream.read(4096)?
                    // EOF before the terminating blank line is a truncated body,
                    // not a complete one.
                    if chunk.length() == 0 {
                        return Err(error_kind("http", "connection closed in chunk trailer"))
                    }
                    buf = buf.concat(chunk)
                }
            }
        } else {
            total += size
            if total > max_body {
                return Err(error_kind("http", "chunked body too large"))
            }
            // Read the chunk data plus its trailing CRLF.
            while buf.length() < size + 2 {
                let chunk = stream.read(4096)?
                if chunk.length() == 0 {
                    return Err(error_kind("http", "connection closed in chunk data"))
                }
                buf = buf.concat(chunk)
            }
            // The two bytes after the data must be the CRLF that terminates the
            // chunk, not arbitrary bytes from a malformed body.
            if buf.substring(size, size + 2) != "\r\n" {
                return Err(error_kind("http", "malformed chunk terminator"))
            }
            decoded = decoded.concat(buf.substring(0, size))
            buf = buf.substring(size + 2, buf.length())
        }
    }
    return Ok(ChunkedBody(body: decoded, rest: buf))
}

// Parse one request, beginning from `initial` (bytes carried over from a prior
// request on the same connection) and reading more from `stream` as needed.
// `Ok(None)` means no request arrived and the connection should close quietly:
// an idle keep-alive client that hung up or sat past the read timeout. A request
// that arrived but failed to parse is an `Err`, which the caller answers with a
// 400, so a read timeout is never mistaken for a malformed request.
fun read_request(
    stream: TcpStream,
    initial: str,
    max_body: int,
) -> Result[Option[ReadResult], Error] {
    var buf = initial
    var split = buf.index_of("\r\n\r\n")
    while split < 0 {
        match stream.read(4096) {
            case Ok(chunk) {
                if chunk.length() == 0 {
                    // No bytes buffered and the peer closed: an idle keep-alive
                    // hang-up, not a request. With bytes buffered it is truncated.
                    if buf.length() == 0 {
                        return Ok(None)
                    }
                    return Err(error_kind("http", "connection closed before headers"))
                }
                buf = buf.concat(chunk)
                split = buf.index_of("\r\n\r\n")
                if buf.length() > 65536 {
                    return Err(error_kind("http", "request headers too large"))
                }
            }
            // A read failure while waiting for the next request line (a read
            // timeout on an idle keep-alive connection, or a reset) is not a
            // malformed request, so close quietly rather than answering 400.
            case Err(_) {
                return Ok(None)
            }
        }
    }
    let head_text = buf.substring(0, split)
    var body = buf.substring(split + 4, buf.length())

    let lines = head_text.split("\r\n")
    if lines.len() == 0 {
        return Err(error_kind("http", "empty request"))
    }
    // A request line is exactly `METHOD SP TARGET SP VERSION`: reject anything
    // with a different token count (extra or missing fields, a target with a
    // raw space). The server speaks HTTP/1.x, so the version must be 1.0 or 1.1.
    let request_line = lines[0].split(" ")
    if request_line.len() != 3 {
        return Err(error_kind("http", "malformed request line"))
    }
    // Method tokens are case-sensitive: reject a lowercase one (`get`) rather
    // than normalizing it, so it cannot route as if it were `GET`.
    let method_token = request_line[0]
    if method_token != method_token.to_upper() {
        return Err(error_kind("http", "malformed method token"))
    }
    let method = parse_method(method_token)
    let target = request_line[1]
    let version = request_line[2]
    if version != "HTTP/1.0" and version != "HTTP/1.1" {
        return Err(error_kind("http", "unsupported HTTP version"))
    }

    let headers: dict[str, str] = Map.new()
    var i = 1
    while i < lines.len() {
        let line = lines[i]
        if line.length() == 0 {
            i += 1
            continue
        }
        // Reject obsolete line folding: a header that begins with whitespace is
        // a continuation of the previous one, which current HTTP forbids.
        if line.starts_with(" ") or line.starts_with("\t") {
            return Err(error_kind("http", "obsolete header line folding"))
        }
        // Every header is `name: value`; a line with no colon is malformed.
        let colon = line.index_of(":")
        if colon <= 0 {
            return Err(error_kind("http", "malformed header line"))
        }
        // The field name is a token: it must be non-empty and every byte a token
        // character, with no surrounding whitespace (a space or tab inside or
        // before the name, like `X Foo:` or `Host :`, is malformed). Validate the
        // raw name before lowercasing it for the lookup key.
        let raw_name = line.substring(0, colon)
        if not is_valid_field_name(raw_name) {
            return Err(error_kind("http", "invalid header field name"))
        }
        let key = raw_name.to_lower()
        // HTTP/1.1 allows exactly one Host header; a second is a routing and
        // request-smuggling ambiguity, so reject a duplicate.
        if key == "host" and headers.has("host") {
            return Err(error_kind("http", "duplicate Host header"))
        }
        var value = line.substring(colon + 1, line.length()).trim()
        // Two Content-Length headers with different values are a request
        // smuggling vector; reject the conflict rather than trusting one.
        if key == "content-length" {
            let existing = headers.get_or("content-length", "")
            if existing.length() > 0 and existing != value {
                return Err(error_kind("http", "conflicting Content-Length"))
            }
        }
        // Repeated Transfer-Encoding or Connection lines combine into one
        // comma-separated list, so a split set of options is seen whole: a
        // `gzip` + `chunked` coding cannot hide a coding the server does not
        // implement, and a `close` on one line beside a `keep-alive` on another
        // is still honored as a close.
        if key == "transfer-encoding" or key == "connection" {
            let existing = headers.get_or(key, "")
            if existing.length() > 0 {
                value = existing.concat(", ").concat(value)
            }
        }
        headers.set(key, value)
        i += 1
    }

    // HTTP/1.1 requires a Host header (RFC 7230 5.4); its absence is malformed.
    if version == "HTTP/1.1" and headers.get_or("host", "").length() == 0 {
        return Err(error_kind("http", "missing Host header"))
    }

    var actual_body = ""
    var rest = ""
    let te = headers.get_or("transfer-encoding", "").trim()
    if te.length() > 0 {
        // The server implements only a sole `chunked` coding. Reject any other
        // coding list (`gzip, chunked`, an unknown coding) rather than routing
        // the request with the wrong or an empty body.
        if not is_chunked_only(te) {
            return Err(error_kind("http", "unsupported transfer-coding"))
        }
        // RFC 7230 3.3.3: Content-Length together with chunked framing is a
        // request-smuggling vector; reject it rather than guessing.
        if headers.get_or("content-length", "").length() > 0 {
            return Err(error_kind("http", "Content-Length with chunked encoding"))
        }
        var decoded = decode_chunked(stream, body, max_body)?
        actual_body = decoded.body
        rest = decoded.rest
    } else {
        var want = 0
        let clen = headers.get_or("content-length", "")
        if clen.length() > 0 {
            // Content-Length is one or more decimal digits, nothing else: reject a
            // leading sign (`+5`, `-5`) or any surrounding whitespace rather than
            // letting a lenient integer parse accept it.
            if not is_all_digits(clen) {
                return Err(error_kind("http", "invalid Content-Length"))
            }
            match clen.parse_int() {
                case Some(n) {
                    want = n
                }
                // A non-numeric Content-Length is a malformed request; answer
                // 400 rather than silently treating the body as empty.
                case None {
                    return Err(error_kind("http", "invalid Content-Length"))
                }
            }
        }
        // Reject a negative or oversized declared body before reading it, so a
        // client cannot make the server buffer unbounded memory. 10 MiB is a
        // generous default for a simple server.
        if want < 0 {
            return Err(error_kind("http", "negative Content-Length"))
        }
        if want > max_body {
            return Err(error_kind("http", "request body too large"))
        }
        while body.length() < want {
            let chunk = stream.read(4096)?
            if chunk.length() == 0 {
                return Err(error_kind("http", "connection closed before body complete"))
            }
            body = body.concat(chunk)
        }
        // Keep exactly `want` bytes as this request's body; anything already
        // read past it is the start of the next pipelined request, carried over
        // so it is not lost when the keep-alive loop reads again.
        actual_body = body.substring(0, want)
        rest = body.substring(want, body.length())
    }

    var path = target
    let query: dict[str, str] = Map.new()
    let q = target.index_of("?")
    if q >= 0 {
        path = target.substring(0, q)
        parse_query(target.substring(q + 1, target.length()), query)
    }

    let params: dict[str, str] = Map.new()
    let context: dict[str, str] = Map.new()
    return Ok(
        Some(
            ReadResult(
                request: Request(
                    method: method,
                    path: path,
                    version: version,
                    headers: headers,
                    params: params,
                    query: query,
                    body: actual_body,
                    context: context,
                ),
                rest: rest,
            ),
        ),
    )
}

// Decode `a=1&b=2` query-string pairs into `out`, percent-decoding each key and
// value and turning `+` into a space (the form-urlencoded convention).
fun parse_query(qs: str, out: dict[str, str]) {
    let pairs = qs.split("&")
    var i = 0
    while i < pairs.len() {
        let pair = pairs[i]
        if pair.length() > 0 {
            let eq = pair.index_of("=")
            if eq >= 0 {
                let k = decode_query_part(pair.substring(0, eq))
                let v = decode_query_part(pair.substring(eq + 1, pair.length()))
                out.set(k, v)
            } else {
                out.set(decode_query_part(pair), "")
            }
        }
        i += 1
    }
}

fun decode_query_part(s: str) -> str {
    return url_decode(s.replace("+", " "))
}

// A 1xx, 204, or 304 response must not carry a message body (RFC 7230 3.3.2),
// regardless of what the handler put in `resp.body`.
fun status_forbids_body(status: int) -> bool {
    if status >= 100 and status < 200 {
        return true
    }
    return status == 204 or status == 304
}

// A 1xx or 204 response must not carry Content-Length either. A 304 still
// reports the length the body would have, like a HEAD response.
fun status_forbids_content_length(status: int) -> bool {
    if status >= 100 and status < 200 {
        return true
    }
    return status == 204
}

// A valid HTTP status code is three digits, 100 through 599. A handler can set
// any int through `status_code`, so an out-of-range value (which would frame a
// malformed status line like `HTTP/1.1 -1 OK`) is replaced with 500.
fun sanitize_status(status: int) -> int {
    if status < 100 or status > 599 {
        return 500
    }
    return status
}

// True if `b` is an HTTP token character (RFC 7230): a letter, digit, or one of
// the punctuation marks a field name may contain. A field name is `1*tchar`, so
// a space, control, or separator byte makes the name invalid.
fun is_tchar(b: int) -> bool {
    if b >= 65 and b <= 90 {
        return true
    }
    if b >= 97 and b <= 122 {
        return true
    }
    if b >= 48 and b <= 57 {
        return true
    }
    // ! # $ % & ' * + - . ^ _ ` | ~
    return b == 33 or b == 35 or b == 36 or b == 37 or b == 38 or b == 39 or b == 42 or b == 43 or b == 45 or b == 46 or b == 94 or b == 95 or b == 96 or b == 124 or b == 126
}

// Non-empty and every byte an ASCII decimal digit. Used to validate a numeric
// header field (Content-Length) strictly, with no sign or whitespace.
fun is_all_digits(s: str) -> bool {
    if s.length() == 0 {
        return false
    }
    var i = 0
    while i < s.length() {
        let b = __str_byte_at(s, i)
        if b < 48 or b > 57 {
            return false
        }
        i += 1
    }
    return true
}

// Non-empty and every byte an ASCII hex digit (`0-9`, `a-f`, `A-F`). Used to
// validate a chunk size strictly, with no sign or surrounding whitespace.
fun is_hex_digits(s: str) -> bool {
    if s.length() == 0 {
        return false
    }
    var i = 0
    while i < s.length() {
        let b = __str_byte_at(s, i)
        let digit = b >= 48 and b <= 57
        let lower = b >= 97 and b <= 102
        let upper = b >= 65 and b <= 70
        if not (digit or lower or upper) {
            return false
        }
        i += 1
    }
    return true
}

// A field name is valid when it is non-empty and every byte is a token character.
fun is_valid_field_name(name: str) -> bool {
    if name.length() == 0 {
        return false
    }
    var i = 0
    while i < name.length() {
        if not is_tchar(__str_byte_at(name, i)) {
            return false
        }
        i += 1
    }
    return true
}

// Strip the bytes a field value must not contain: the C0 controls and DEL,
// except HTAB which is allowed. The visible bytes and obs-text (0x80..0xFF) are
// kept, so a normal value is unchanged.
fun sanitize_field_value(value: str) -> str {
    let out: list[str] = []
    var i = 0
    while i < value.length() {
        let b = __str_byte_at(value, i)
        let forbidden = (b < 32 and b != 9) or b == 127
        if not forbidden {
            out.push(value.substring(i, i + 1))
        }
        i += 1
    }
    return "".join(out)
}

// Remove every header whose name matches `lower_name` (already lowercase),
// compared case-insensitively since HTTP field names are case-insensitive.
fun remove_header_ci(headers: dict[str, str], lower_name: str) {
    let keys = headers.keys()
    var i = 0
    while i < keys.len() {
        if keys[i].to_lower() == lower_name {
            let _ = headers.remove(keys[i])
        }
        i += 1
    }
}

// Write `resp` to `stream` as an HTTP/1.1 response, framing it with
// Content-Length and closing the connection after.
fun write_response(stream: TcpStream, resp: Response, keep_alive: bool, is_head: bool) {
    // Frame the wire status from a sanitized code, so a handler's out-of-range
    // status cannot produce a malformed status line.
    let code = sanitize_status(resp.status)
    // The server frames every response with Content-Length and never uses chunked
    // transfer, so a handler-set framing header must not override that. Clear both
    // (case-insensitively), then set the authoritative Content-Length unless the
    // status forbids it (1xx, 204).
    remove_header_ci(resp.headers, "content-length")
    remove_header_ci(resp.headers, "transfer-encoding")
    if not status_forbids_content_length(code) {
        // Content-Length always reports what a GET would return, even for HEAD.
        resp.headers.set("Content-Length", resp.body.length().to_string())
    }
    if keep_alive {
        resp.headers.set("Connection", "keep-alive")
    } else {
        resp.headers.set("Connection", "close")
    }
    let status_line = "HTTP/1.1 ".concat(code.to_string()).concat(" ")
    let line = status_line.concat(reason_phrase(code)).concat("\r\n")
    var block = ""
    let keys = resp.headers.keys()
    var i = 0
    while i < keys.len() {
        let k = keys[i]
        if is_valid_field_name(k) {
            // Several cookies share the one Set-Cookie entry, separated by
            // newlines; each goes out as its own header line.
            let raw = resp.headers.get_or(k, "")
            for part in raw.split("\n") {
                if part != "" or raw == "" {
                    block = block.concat(k).concat(": ").concat(sanitize_field_value(part)).concat("\r\n")
                }
            }
        }
        i += 1
    }
    // A response to a HEAD request, or one whose status forbids a body, carries
    // the headers but no body.
    var out = line.concat(block).concat("\r\n")
    if not is_head and not status_forbids_body(code) {
        out = out.concat(resp.body)
    }
    let _ = stream.write(out)
}

// Convert a timeout in seconds to milliseconds without overflowing. A value so
// large that `seconds * 1000` would wrap past the int range (and read back as a
// non-positive, "disabled" timeout) is clamped to a very large bound instead. A
// non-positive `seconds` disables the timeout (0).
fun timeout_ms(seconds: int) -> int {
    if seconds <= 0 {
        return 0
    }
    // `int` is 64-bit, so 9223372036854775 is floor(max / 1000): anything larger
    // would overflow when multiplied by 1000.
    if seconds > 9223372036854775 {
        return 9223372036854775000
    }
    return seconds * 1000
}

// The reason phrase for a status code. Covers the common codes; an unknown
// code falls back to a phrase for its class (`Server Error` for 5xx, and so on)
// rather than a misleading `OK`, so a 503 is never labelled `503 OK`.
fun reason_phrase(status: int) -> str {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 202 {
        return "Accepted"
    }
    if status == 204 {
        return "No Content"
    }
    if status == 301 {
        return "Moved Permanently"
    }
    if status == 302 {
        return "Found"
    }
    if status == 304 {
        return "Not Modified"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 401 {
        return "Unauthorized"
    }
    if status == 403 {
        return "Forbidden"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 409 {
        return "Conflict"
    }
    if status == 422 {
        return "Unprocessable Entity"
    }
    if status == 429 {
        return "Too Many Requests"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    if status == 501 {
        return "Not Implemented"
    }
    if status == 502 {
        return "Bad Gateway"
    }
    if status == 503 {
        return "Service Unavailable"
    }
    if status == 504 {
        return "Gateway Timeout"
    }
    if status >= 100 and status < 200 {
        return "Informational"
    }
    if status >= 200 and status < 300 {
        return "Success"
    }
    if status >= 300 and status < 400 {
        return "Redirection"
    }
    if status >= 400 and status < 500 {
        return "Client Error"
    }
    if status >= 500 and status < 600 {
        return "Server Error"
    }
    return "Unknown"
}

// Serve the `:file` capture of a `Server.static` route from its directory.
fun serve_from(dir: str, req: Request) -> Response {
    let name = req.param("file")
    // The captured path may hold subdirectories (`img/a.svg`) but must stay
    // inside `dir`. Reject anything that could climb out: a backslash (a path
    // separator on Windows), a parent reference, a drive or stream marker, an
    // empty or dot segment, or an empty name. Without this a request like
    // `..\..\secret` would escape.
    if name.length() == 0 {
        return Response.with_body(404, "Not Found")
    }
    for segment in name.split("/") {
        if segment == "" or segment == "." {
            return Response.with_body(404, "Not Found")
        }
    }
    if name.contains("\\") {
        return Response.with_body(404, "Not Found")
    }
    if name.contains("..") {
        return Response.with_body(404, "Not Found")
    }
    if name.contains(":") {
        return Response.with_body(404, "Not Found")
    }
    // A symlink inside `dir` could point anywhere, so a path through one is
    // refused rather than followed out of the directory.
    var path = dir
    for segment in name.split("/") {
        path = path.concat("/").concat(segment)
        if is_symlink(path) {
            return Response.with_body(404, "Not Found")
        }
    }
    return Response.file(path)
}

// A `Content-Type` for a file path, chosen from its extension.
fun content_type_for(path: str) -> str {
    if path.ends_with(".html") {
        return "text/html; charset=utf-8"
    }
    if path.ends_with(".css") {
        return "text/css; charset=utf-8"
    }
    if path.ends_with(".js") {
        return "application/javascript"
    }
    if path.ends_with(".json") {
        return "application/json"
    }
    if path.ends_with(".svg") {
        return "image/svg+xml"
    }
    if path.ends_with(".txt") {
        return "text/plain; charset=utf-8"
    }
    return "application/octet-stream"
}

fun _run_chain(server: Server, i: int, req: Request) -> Response {
    if i >= server.middleware.len() {
        return dispatch(server.routes, req)
    }
    let mw = server.middleware[i]
    return mw(req, (r: Request) -> Response => _run_chain(server, i + 1, r))
}

extern "C" {
    fun raven_compress(kind: str, data: str, level: int) -> str
}

fun _compressible(content_type: str) -> bool {
    let ct = content_type.to_lower()
    return ct.starts_with("text/") or ct.contains("json") or ct.contains("javascript") or ct.contains(
        "svg",
    ) or ct.contains("xml")
}

fun _header_ci(headers: dict[str, str], name: str) -> str {
    for k in headers.keys() {
        if k.to_lower() == name {
            return headers.get_or(k, "")
        }
    }
    return ""
}

fun _maybe_gzip(req: Request, resp: Response) -> Response {
    if resp.body.length() < 1024 or _header_ci(resp.headers, "content-encoding") != "" {
        return resp
    }
    if not _compressible(_header_ci(resp.headers, "content-type")) {
        return resp
    }
    if not req.header("accept-encoding").to_lower().contains("gzip") {
        return resp
    }
    let packed = raven_compress("gzip", resp.body, 6)
    if packed.length() == 0 {
        return resp
    }
    resp.body = packed
    resp.headers.set("Content-Encoding", "gzip")
    resp.headers.set("Vary", "Accept-Encoding")
    return resp
}

// A cookie to send with `Response.set_cookie`. Defaults are the safe ones:
// path `/`, HttpOnly, SameSite=Lax, no expiry (a session cookie).
class Cookie {
    name: str
    value: str
    path: str
    domain: str
    max_age: int
    http_only: bool
    secure: bool
    same_site: str
}

impl Cookie {
    fun new(name: str, value: str) -> Cookie {
        return Cookie(
            name: name,
            value: value,
            path: "/",
            domain: "",
            max_age: -1,
            http_only: true,
            secure: false,
            same_site: "Lax",
        )
    }

    fun with_path(self, path: str) -> Cookie {
        self.path = path
        return self
    }

    fun with_domain(self, domain: str) -> Cookie {
        self.domain = domain
        return self
    }

    // Lifetime in seconds; 0 deletes the cookie, -1 (the default) lasts the
    // browser session.
    fun with_max_age(self, seconds: int) -> Cookie {
        self.max_age = seconds
        return self
    }

    fun with_secure(self, on: bool) -> Cookie {
        self.secure = on
        return self
    }

    fun with_http_only(self, on: bool) -> Cookie {
        self.http_only = on
        return self
    }

    // "Strict", "Lax", or "None" (which needs `with_secure(true)`).
    fun with_same_site(self, mode: str) -> Cookie {
        self.same_site = mode
        return self
    }

    fun header_value(self) -> str {
        var out = "${self.name}=${self.value}"
        if self.path != "" {
            out += "; Path=${self.path}"
        }
        if self.domain != "" {
            out += "; Domain=${self.domain}"
        }
        if self.max_age >= 0 {
            out += "; Max-Age=${self.max_age}"
        }
        if self.http_only {
            out += "; HttpOnly"
        }
        if self.secure {
            out += "; Secure"
        }
        if self.same_site != "" {
            out += "; SameSite=${self.same_site}"
        }
        return out
    }
}

impl Request {
    // The value of cookie `name` from the Cookie header, or None.
    fun cookie(self, name: str) -> Option[str] {
        for part in self.header("cookie").split(";") {
            let kv = part.trim()
            let eq = kv.index_of("=")
            if eq > 0 and kv.substring(0, eq) == name {
                return Some(kv.substring(eq + 1, kv.length()))
            }
        }
        return None
    }

    // Attach a value for later middleware and handlers.
    fun set_value(self, key: str, value: str) {
        self.context.set(key, value)
    }

    // A value attached by middleware, or None.
    fun value(self, key: str) -> Option[str] {
        if self.context.has(key) {
            return Some(self.context.get_or(key, ""))
        }
        return None
    }

    // The bearer token from `Authorization: Bearer <token>`, or None.
    fun bearer_token(self) -> Option[str] {
        let auth = self.header("authorization")
        if auth.length() > 7 and auth.substring(0, 7).to_lower() == "bearer " {
            return Some(auth.substring(7, auth.length()).trim())
        }
        return None
    }
}

impl Response {
    // Add a Set-Cookie header; call once per cookie.
    fun set_cookie(self, cookie: Cookie) -> Response {
        let existing = _header_ci(self.headers, "set-cookie")
        let line = cookie.header_value()
        self.headers.set("Set-Cookie", line if existing == "" else existing + "\n" + line)
        return self
    }

    // Tell the browser to delete cookie `name`.
    fun clear_cookie(self, name: str) -> Response {
        return self.set_cookie(Cookie.new(name, "").with_max_age(0))
    }
}

// An HTTP client with a base URL, default headers, and a timeout, like a
// requests Session. Paths given to its methods are joined to the base URL;
// a full `http://` or `https://` URL is used as is.
class Client {
    base_url: str
    headers: dict[str, str]
    timeout_ms: int
}

impl Client {
    fun new(base_url: str) -> Client {
        let headers: dict[str, str] = Map.new()
        var base = base_url
        while base.ends_with("/") {
            base = base.substring(0, base.length() - 1)
        }
        return Client(base_url: base, headers: headers, timeout_ms: 30000)
    }

    fun with_header(self, name: str, value: str) -> Client {
        self.headers.set(name, value)
        return self
    }

    fun with_bearer(self, token: str) -> Client {
        return self.with_header("Authorization", "Bearer ${token}")
    }

    fun with_timeout_ms(self, ms: int) -> Client {
        self.timeout_ms = ms
        return self
    }

    fun _url(self, path: str) -> str {
        if path.starts_with("http://") or path.starts_with("https://") {
            return path
        }
        return self.base_url + path if path.starts_with("/") else self.base_url + "/" + path
    }

    fun _headers(self, extra: dict[str, str]) -> str {
        let lines: list[str] = []
        for k in self.headers.keys() {
            if not extra.has(k) {
                lines.push("${k}: ${self.headers.get_or(k, "")}")
            }
        }
        for k in extra.keys() {
            lines.push("${k}: ${extra.get_or(k, "")}")
        }
        return "\n".join(lines)
    }

    // Send a request with extra headers for this call only.
    fun send(
        self,
        method: str,
        path: str,
        body: str,
        extra: dict[str, str],
    ) -> Result[HttpResponse, Error] {
        return request_with_timeout(
            method,
            self._url(path),
            body,
            self._headers(extra),
            self.timeout_ms,
        )
    }

    fun get(self, path: str) -> Result[HttpResponse, Error] {
        let none: dict[str, str] = Map.new()
        return self.send("GET", path, "", none)
    }

    fun delete(self, path: str) -> Result[HttpResponse, Error] {
        let none: dict[str, str] = Map.new()
        return self.send("DELETE", path, "", none)
    }

    // POST, PUT, and PATCH send `body` as JSON.
    fun post(self, path: str, body: str) -> Result[HttpResponse, Error] = self._json(
        "POST",
        path,
        body,
    )

    fun put(self, path: str, body: str) -> Result[HttpResponse, Error] = self._json(
        "PUT",
        path,
        body,
    )

    fun patch(self, path: str, body: str) -> Result[HttpResponse, Error] = self._json(
        "PATCH",
        path,
        body,
    )

    fun _json(self, method: str, path: str, body: str) -> Result[HttpResponse, Error] {
        let extra: dict[str, str] = Map.new()
        if not self.headers.has("Content-Type") {
            extra.set("Content-Type", "application/json")
        }
        return self.send(method, path, body, extra)
    }
}
