}

impl[A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash] Hash for Tuple6[A, B, C, D, E, F] {
    fun hash(self) -> int {
        var h = self._0.hash()
        h = h * 31 + self._1.hash()
        h = h * 31 + self._2.hash()
        h = h * 31 + self._3.hash()
        h = h * 31 + self._4.hash()
        h = h * 31 + self._5.hash()
        return h
    }
}

