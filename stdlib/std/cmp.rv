// std.cmp: ordering and sorting over the prelude `Ord` trait.

fun min[T: Ord](a: T, b: T) -> T {
    if a.compare(b) <= 0 {
        return a
    }
    return b
}

fun max[T: Ord](a: T, b: T) -> T {
    if a.compare(b) >= 0 {
        return a
    }
    return b
}

fun clamp[T: Ord](x: T, lo: T, hi: T) -> T {
    if x.compare(lo) < 0 {
        return lo
    }
    if x.compare(hi) > 0 {
        return hi
    }
    return x
}

// A new list sorted by an explicit comparator; stable.
fun sorted_by[T](xs: list[T], cmp: fun(T, T) -> int) -> list[T] = xs.sorted_by(cmp)

fun sort[T: Ord](xs: list[T]) -> list[T] = xs.sorted()

fun max_of[T: Ord](xs: list[T]) -> Option[T] {
    let n = xs.len()
    if n == 0 {
        return None
    }
    var best = xs[0]
    var i = 1
    while i < n {
        if xs[i].compare(best) > 0 {
            best = xs[i]
        }
        i = i + 1
    }
    return Some(best)
}

fun min_of[T: Ord](xs: list[T]) -> Option[T] {
    let n = xs.len()
    if n == 0 {
        return None
    }
    var best = xs[0]
    var i = 1
    while i < n {
        if xs[i].compare(best) < 0 {
            best = xs[i]
        }
        i = i + 1
    }
    return Some(best)
}
