// std.json: a JSON parser and serializer in pure Raven over the byte
// intrinsics. `parse` is a recursive descent parser returning
// Result[JsonValue, Error]; `stringify` is a compact serializer. All JSON
// numbers parse to float, so integers beyond the 53-bit mantissa lose
// precision. See docs/guide/stdlib/json.md.

import std.collections
import std.error
import std.string

extern "C" {
    fun raven_int_to_float(x: int) -> float
    fun raven_float_to_int(x: float) -> int
}

// The JSON value tree. Construct variants with the qualified form
// (`JsonValue.Null`, `JsonValue.Number(1.0)`, ...); match with the bare
// variant names. Object preserves insertion order through the underlying
// Map's parallel key and value lists.
enum JsonValue {
    Null,
    Bool(bool),
    Number(float),
    Str(str),
    Array(list[JsonValue]),
    Object(dict[str, JsonValue]),
}

// A JsonError is an std.error `Error` tagged with kind "json". Raven has
// no type alias and a bundled module cannot call another bundled module's
// free functions, so the struct literal is built directly here.
fun json_error(msg: str) -> Error {
    return Error(kind: "json", message: msg)
}

// Parser cursor: the input bytes and the current byte offset. A shared
// Cursor is threaded through the recursive helpers, which advance it by
// mutating `pos`.
class Cursor {
    text: str
    pos: int
    depth: int
}

impl Cursor {
    fun at_end(self) -> bool {
        return self.pos >= __str_len(self.text)
    }

    // Current byte, or -1 at end of input.
    fun peek(self) -> int {
        if self.pos >= __str_len(self.text) {
            return -1
        }
        return __str_byte_at(self.text, self.pos)
    }

    fun advance(self) {
        self.pos = self.pos + 1
    }

    fun skip_ws(self) {
        var scanning = true
        while scanning {
            let b = self.peek()
            if b == 32 {
                self.pos = self.pos + 1
            } else if b == 9 {
                self.pos = self.pos + 1
            } else if b == 10 {
                self.pos = self.pos + 1
            } else if b == 13 {
                self.pos = self.pos + 1
            } else {
                scanning = false
            }
        }
    }
}

fun is_digit(b: int) -> bool {
    return b >= 48 and b <= 57
}

// Append the UTF-8 encoding of a Unicode code point to `out`.
fun encode_utf8(out: str, cp: int) -> str {
    if cp < 128 {
        return __str_concat(out, __str_from_byte(cp))
    }
    if cp < 2048 {
        let b0 = 192 | (cp >> 6)
        let b1 = 128 | (cp & 63)
        return __str_concat(__str_concat(out, __str_from_byte(b0)), __str_from_byte(b1))
    }
    if cp < 65536 {
        let b0 = 224 | (cp >> 12)
        let b1 = 128 | ((cp >> 6) & 63)
        let b2 = 128 | (cp & 63)
        var r = __str_concat(out, __str_from_byte(b0))
        r = __str_concat(r, __str_from_byte(b1))
        return __str_concat(r, __str_from_byte(b2))
    }
    let b0 = 240 | (cp >> 18)
    let b1 = 128 | ((cp >> 12) & 63)
    let b2 = 128 | ((cp >> 6) & 63)
    let b3 = 128 | (cp & 63)
    var r = __str_concat(out, __str_from_byte(b0))
    r = __str_concat(r, __str_from_byte(b1))
    r = __str_concat(r, __str_from_byte(b2))
    return __str_concat(r, __str_from_byte(b3))
}

// Value of one hex digit byte, or -1 when it is not a hex digit.
fun hex_nibble(b: int) -> int {
    if b >= 48 and b <= 57 {
        return b - 48
    }
    if b >= 97 and b <= 102 {
        return b - 87
    }
    if b >= 65 and b <= 70 {
        return b - 55
    }
    return -1
}

// Read four hex digits starting at the cursor, returning the 16-bit code
// unit or -1 on a non-hex digit or short input. Advances the cursor over
// the digits read.
fun read_hex4(c: Cursor) -> int {
    var value = 0
    var i = 0
    while i < 4 {
        let n = hex_nibble(c.peek())
        if n < 0 {
            return -1
        }
        value = (value << 4) | n
        c.advance()
        i = i + 1
    }
    return value
}

// Parse the body of a string literal after the opening quote. Returns the
// decoded str, or an Err on a bad escape or unterminated input. The
// cursor ends just past the closing quote.
fun parse_string(c: Cursor) -> Result[str, Error] {
    var out = ""
    var scanning = true
    while scanning {
        if c.at_end() {
            return Err(json_error("unterminated string"))
        }
        let b = c.peek()
        c.advance()
        if b == 34 {
            scanning = false
        } else if b == 92 {
            let e = c.peek()
            c.advance()
            if e == 34 {
                out = __str_concat(out, __str_from_byte(34))
            } else if e == 92 {
                out = __str_concat(out, __str_from_byte(92))
            } else if e == 47 {
                out = __str_concat(out, __str_from_byte(47))
            } else if e == 98 {
                out = __str_concat(out, __str_from_byte(8))
            } else if e == 102 {
                out = __str_concat(out, __str_from_byte(12))
            } else if e == 110 {
                out = __str_concat(out, __str_from_byte(10))
            } else if e == 114 {
                out = __str_concat(out, __str_from_byte(13))
            } else if e == 116 {
                out = __str_concat(out, __str_from_byte(9))
            } else if e == 117 {
                let cp = read_hex4(c)
                if cp < 0 {
                    return Err(json_error("bad unicode escape"))
                }
                if cp >= 55296 and cp <= 56319 {
                    // High surrogate: decode an astral code point when a
                    // low surrogate follows. Unpaired surrogates are invalid
                    // JSON strings for this parser.
                    if c.peek() == 92 {
                        c.advance()
                        if c.peek() == 117 {
                            c.advance()
                            let low = read_hex4(c)
                            if low >= 56320 and low <= 57343 {
                                let astral = 65536 + ((cp - 55296) << 10) + (low - 56320)
                                out = encode_utf8(out, astral)
                            } else {
                                return Err(json_error("invalid low surrogate in \\u escape"))
                            }
                        } else {
                            return Err(json_error("unpaired high surrogate in \\u escape"))
                        }
                    } else {
                        return Err(json_error("unpaired high surrogate in \\u escape"))
                    }
                } else if cp >= 56320 and cp <= 57343 {
                    return Err(json_error("lone low surrogate in \\u escape"))
                } else {
                    out = encode_utf8(out, cp)
                }
            } else {
                return Err(json_error("bad escape"))
            }
        } else {
            // JSON forbids a raw control character (U+0000..U+001F) in a
            // string; it must be escaped. Reject it rather than copy it through.
            if b < 32 {
                return Err(json_error("unescaped control character in string"))
            }
            if b < 128 {
                out = __str_concat(out, __str_from_byte(b))
            } else {
                let start = c.pos - 1
                let len = utf8_seq_len(c.text, start, c.text.length())
                if len == 0 {
                    return Err(json_error("invalid UTF-8 in string"))
                }
                var j = 0
                while j < len {
                    out = __str_concat(out, __str_from_byte(__str_byte_at(c.text, start + j)))
                    j = j + 1
                }
                c.pos = c.pos + (len - 1)
            }
        }
    }
    return Ok(out)
}

// Parse a JSON number into a float. The cursor is positioned at the first
// byte of the number (an optional minus or a digit). Integer digits build
// a float through raven_int_to_float; fraction digits divide by powers of
// ten; an exponent scales the result.
fun parse_number(c: Cursor) -> Result[float, Error] {
    var negative = false
    if c.peek() == 45 {
        negative = true
        c.advance()
    }
    if not is_digit(c.peek()) {
        return Err(json_error("invalid number"))
    }
    let lead = c.peek()
    var int_value = 0.0
    var int_digits = 0
    while is_digit(c.peek()) {
        let d = c.peek() - 48
        int_value = int_value * 10.0 + raven_int_to_float(d)
        c.advance()
        int_digits = int_digits + 1
    }
    // JSON forbids a leading zero in the integer part (`01`, `00`); a lone `0`
    // is fine.
    if lead == 48 and int_digits > 1 {
        return Err(json_error("number has a leading zero"))
    }
    var value = int_value
    if c.peek() == 46 {
        c.advance()
        if not is_digit(c.peek()) {
            return Err(json_error("invalid fraction"))
        }
        var scale = 1.0
        var frac = 0.0
        while is_digit(c.peek()) {
            let d = c.peek() - 48
            frac = frac * 10.0 + raven_int_to_float(d)
            scale = scale * 10.0
            c.advance()
        }
        value = value + frac / scale
    }
    let e = c.peek()
    if e == 101 or e == 69 {
        c.advance()
        var exp_negative = false
        if c.peek() == 43 {
            c.advance()
        } else if c.peek() == 45 {
            exp_negative = true
            c.advance()
        }
        if not is_digit(c.peek()) {
            return Err(json_error("invalid exponent"))
        }
        // f64 saturates to infinity past about 1e308, so an exponent beyond a
        // few hundred yields the same result (infinity, or zero for a negative
        // exponent) as any larger one. Stop accumulating once the value is well
        // past that point so the digits of a huge exponent like 1e999999999
        // cannot overflow int and wrap into a small or negative step count.
        var exp = 0
        while is_digit(c.peek()) {
            if exp <= 400 {
                exp = exp * 10 + (c.peek() - 48)
            }
            c.advance()
        }
        var steps = exp
        if steps > 400 {
            steps = 400
        }
        var factor = 1.0
        var i = 0
        while i < steps {
            factor = factor * 10.0
            i = i + 1
        }
        if exp_negative {
            value = value / factor
        } else {
            value = value * factor
        }
    }
    if negative {
        // Multiply by -1 rather than subtract from 0, so `-0` and `-0.0` keep
        // their sign: `0.0 - 0.0` is `+0.0`, but `0.0 * -1.0` is `-0.0`.
        value = value * (0.0 - 1.0)
    }
    return Ok(value)
}

// True when the next bytes spell `word`; advances over them on a match.
fun match_keyword(c: Cursor, word: str) -> bool {
    let n = __str_len(word)
    var i = 0
    while i < n {
        if __str_byte_at(c.text, c.pos + i) != __str_byte_at(word, i) {
            return false
        }
        i = i + 1
    }
    c.pos = c.pos + n
    return true
}

fun parse_value(c: Cursor) -> Result[JsonValue, Error] {
    c.skip_ws()
    let b = c.peek()
    // Containers recurse, so bound the nesting depth to keep untrusted input
    // from overflowing the stack. Depth is incremented on the way into a
    // container and decremented on the way out, so siblings at the same level
    // do not accumulate; only genuine nesting counts.
    if b == 123 {
        c.depth = c.depth + 1
        if c.depth > 256 {
            return Err(json_error("maximum nesting depth exceeded"))
        }
        var v = parse_object(c)?
        c.depth = c.depth - 1
        return Ok(v)
    }
    if b == 91 {
        c.depth = c.depth + 1
        if c.depth > 256 {
            return Err(json_error("maximum nesting depth exceeded"))
        }
        var v = parse_array(c)?
        c.depth = c.depth - 1
        return Ok(v)
    }
    if b == 34 {
        c.advance()
        let s = parse_string(c)?
        return Ok(JsonValue.Str(s))
    }
    if b == 116 {
        if match_keyword(c, "true") {
            return Ok(JsonValue.Bool(true))
        }
        return Err(json_error("invalid token"))
    }
    if b == 102 {
        if match_keyword(c, "false") {
            return Ok(JsonValue.Bool(false))
        }
        return Err(json_error("invalid token"))
    }
    if b == 110 {
        if match_keyword(c, "null") {
            return Ok(JsonValue.Null)
        }
        return Err(json_error("invalid token"))
    }
    if b == 45 or is_digit(b) {
        let n = parse_number(c)?
        return Ok(JsonValue.Number(n))
    }
    return Err(json_error("unexpected byte at offset ".concat(offset_str(c.pos))))
}

fun parse_array(c: Cursor) -> Result[JsonValue, Error] {
    c.advance()
    let items: list[JsonValue] = []
    c.skip_ws()
    if c.peek() == 93 {
        c.advance()
        return Ok(JsonValue.Array(items))
    }
    var scanning = true
    while scanning {
        var v = parse_value(c)?
        items.push(v)
        c.skip_ws()
        let b = c.peek()
        if b == 44 {
            c.advance()
        } else if b == 93 {
            c.advance()
            scanning = false
        } else {
            return Err(json_error("expected , or ] in array"))
        }
    }
    return Ok(JsonValue.Array(items))
}

fun parse_object(c: Cursor) -> Result[JsonValue, Error] {
    c.advance()
    let map: dict[str, JsonValue] = Map.new()
    c.skip_ws()
    if c.peek() == 125 {
        c.advance()
        return Ok(JsonValue.Object(map))
    }
    var scanning = true
    while scanning {
        c.skip_ws()
        if c.peek() != 34 {
            return Err(json_error("expected string key in object"))
        }
        c.advance()
        let key = parse_string(c)?
        c.skip_ws()
        if c.peek() != 58 {
            return Err(json_error("expected : in object"))
        }
        c.advance()
        var v = parse_value(c)?
        map.set(key, v)
        c.skip_ws()
        let b = c.peek()
        if b == 44 {
            c.advance()
        } else if b == 125 {
            c.advance()
            scanning = false
        } else {
            return Err(json_error("expected , or } in object"))
        }
    }
    return Ok(JsonValue.Object(map))
}

// Render a non-negative byte offset as decimal.
fun offset_str(n: int) -> str {
    if n == 0 {
        return "0"
    }
    var digits = ""
    var v = n
    while v > 0 {
        digits = __str_concat(__str_from_byte(48 + (v - (v / 10) * 10)), digits)
        v = v / 10
    }
    return digits
}

// Parse `text` as a single JSON value. Trailing content other than
// whitespace after the top-level value is rejected.
fun parse(text: str) -> Result[JsonValue, Error] {
    let c = Cursor(text: text, pos: 0, depth: 0)
    var v = parse_value(c)?
    c.skip_ws()
    if not c.at_end() {
        return Err(json_error("trailing content at offset ".concat(offset_str(c.pos))))
    }
    return Ok(v)
}

// Append the JSON string escaping of `s` (without surrounding quotes) to
// `out`. Control bytes below 0x20 become \uXXXX; quote and backslash are
// escaped; every other byte passes through unchanged.
fun escape_string(out: str, s: str) -> str {
    // Runs that need no escaping are copied whole and everything is joined
    // once; appending byte by byte copied the result again for every byte.
    let n = __str_len(s)
    let parts: list[str] = [out]
    var start = 0
    var i = 0
    while i < n {
        let b = __str_byte_at(s, i)
        var esc = ""
        var step = 1
        if b == 34 {
            esc = "\\\""
        } else if b == 92 {
            esc = "\\\\"
        } else if b == 8 {
            esc = "\\b"
        } else if b == 12 {
            esc = "\\f"
        } else if b == 10 {
            esc = "\\n"
        } else if b == 13 {
            esc = "\\r"
        } else if b == 9 {
            esc = "\\t"
        } else if b < 32 {
            esc = __str_concat("\\u00", __str_concat(__str_from_byte(hex_digit(b >> 4)), __str_from_byte(hex_digit(b & 15))))
        } else if b >= 128 {
            // JSON allows raw UTF-8, so a valid sequence passes through; a
            // Raven str can hold arbitrary bytes, and an invalid byte becomes
            // the U+FFFD escape so the output is always valid JSON.
            let len = utf8_seq_len(s, i, n)
            if len == 0 {
                esc = "\\uFFFD"
            } else {
                step = len
            }
        }
        if esc != "" {
            parts.push(__str_substring(s, start, i))
            parts.push(esc)
            start = i + 1
        }
        i = i + step
    }
    if start == 0 {
        return __str_concat(out, s)
    }
    parts.push(__str_substring(s, start, n))
    return "".join(parts)
}

// The length (1..4) of the valid UTF-8 sequence starting at byte `i` of `s`, or
// 0 when the byte cannot begin a valid sequence (an invalid lead byte or a
// truncated/ill-formed continuation).
fun utf8_seq_len(s: str, i: int, n: int) -> int {
    let b = __str_byte_at(s, i)
    if b < 128 {
        return 1
    }
    if b >= 194 and b <= 223 {
        if i + 1 < n and is_utf8_cont(__str_byte_at(s, i + 1)) {
            return 2
        }
        return 0
    }
    if b == 224 {
        if i + 2 < n and utf8_in_range(__str_byte_at(s, i + 1), 160, 191) and is_utf8_cont(
            __str_byte_at(s, i + 2),
        ) {
            return 3
        }
        return 0
    }
    if b >= 225 and b <= 236 {
        if i + 2 < n and is_utf8_cont(__str_byte_at(s, i + 1)) and is_utf8_cont(__str_byte_at(s, i + 2)) {
            return 3
        }
        return 0
    }
    if b == 237 {
        if i + 2 < n and utf8_in_range(__str_byte_at(s, i + 1), 128, 159) and is_utf8_cont(
            __str_byte_at(s, i + 2),
        ) {
            return 3
        }
        return 0
    }
    if b >= 238 and b <= 239 {
        if i + 2 < n and is_utf8_cont(__str_byte_at(s, i + 1)) and is_utf8_cont(__str_byte_at(s, i + 2)) {
            return 3
        }
        return 0
    }
    if b == 240 {
        if i + 3 < n and utf8_in_range(__str_byte_at(s, i + 1), 144, 191) and is_utf8_cont(
            __str_byte_at(s, i + 2),
        ) and is_utf8_cont(__str_byte_at(s, i + 3)) {
            return 4
        }
        return 0
    }
    if b >= 241 and b <= 243 {
        if i + 3 < n and is_utf8_cont(__str_byte_at(s, i + 1)) and is_utf8_cont(__str_byte_at(s, i + 2)) and is_utf8_cont(
            __str_byte_at(s, i + 3),
        ) {
            return 4
        }
        return 0
    }
    if b == 244 {
        if i + 3 < n and utf8_in_range(__str_byte_at(s, i + 1), 128, 143) and is_utf8_cont(
            __str_byte_at(s, i + 2),
        ) and is_utf8_cont(__str_byte_at(s, i + 3)) {
            return 4
        }
        return 0
    }
    return 0
}

fun utf8_in_range(b: int, lo: int, hi: int) -> bool {
    return b >= lo and b <= hi
}

fun is_utf8_cont(b: int) -> bool {
    return b >= 128 and b <= 191
}

fun hex_digit(v: int) -> int {
    if v < 10 {
        return 48 + v
    }
    return 87 + v
}

// Render a JSON number. A non-finite float (infinity or NaN) has no JSON form,
// so it is written as `null`, the way mainstream JSON encoders handle it. A
// value is finite exactly when `n - n` is zero; for an infinity or a NaN that
// subtraction is NaN.
fun number_to_json(n: float) -> str {
    if n - n == 0.0 {
        let text = n.to_string()
        // A whole number is written without a fraction: `1`, not `1.0`.
        if text.ends_with(".0") {
            return text.substring(0, text.len() - 2)
        }
        return text
    }
    return "null"
}

// Compact (non-pretty) serialization. A whole-number float renders the way
// the runtime's float-to-string does (for example 1 prints as `1`).
fun stringify(value: JsonValue) -> str {
    return match value {
        case Null { "null" }
        case Bool(b) { "true" if b else "false" }
        case Number(n) { number_to_json(n) }
        case Str(s) {
            let q = __str_concat("\"", escape_string("", s))
            __str_concat(q, "\"")
        }
        case Array(items) {
            let parts: list[str] = []
            for item in items {
                parts.push(stringify(item))
            }
            __str_concat(__str_concat("[", ",".join(parts)), "]")
        }
        case Object(map) {
            let keys = map.keys()
            let values = map.values()
            let parts: list[str] = []
            var i = 0
            while i < keys.len() {
                let kq = __str_concat("\"", escape_string("", keys[i]))
                parts.push(__str_concat(__str_concat(kq, "\":"), stringify(values[i])))
                i = i + 1
            }
            __str_concat(__str_concat("{", ",".join(parts)), "}")
        }
    }
}

// `n` spaces, for pretty-printing indentation.
fun pretty_indent(n: int) -> str {
    let out: list[str] = []
    var i = 0
    while i < n {
        out.push(" ")
        i = i + 1
    }
    return "".join(out)
}

fun stringify_pretty_at(value: JsonValue, indent: int, depth: int) -> str {
    return match value {
        case Null { "null" }
        case Bool(b) { "true" if b else "false" }
        case Number(n) { number_to_json(n) }
        case Str(s) {
            let q = __str_concat("\"", escape_string("", s))
            __str_concat(q, "\"")
        }
        case Array(items) {
            let n = items.len()
            if n == 0 {
                "[]"
            } else {
                let pad = pretty_indent((depth + 1) * indent)
                let closepad = pretty_indent(depth * indent)
                var out = "[\n"
                var i = 0
                while i < n {
                    if i > 0 {
                        out = __str_concat(out, ",\n")
                    }
                    out = __str_concat(out, pad)
                    out = __str_concat(out, stringify_pretty_at(items[i], indent, depth + 1))
                    i = i + 1
                }
                out = __str_concat(out, "\n")
                out = __str_concat(out, closepad)
                __str_concat(out, "]")
            }
        }
        case Object(map) {
            let keys = map.keys()
            let values = map.values()
            let n = keys.len()
            if n == 0 {
                "{}"
            } else {
                let pad = pretty_indent((depth + 1) * indent)
                let closepad = pretty_indent(depth * indent)
                var out = "{\n"
                var i = 0
                while i < n {
                    if i > 0 {
                        out = __str_concat(out, ",\n")
                    }
                    out = __str_concat(out, pad)
                    let kq = __str_concat("\"", escape_string("", keys[i]))
                    out = __str_concat(out, __str_concat(kq, "\": "))
                    out = __str_concat(out, stringify_pretty_at(values[i], indent, depth + 1))
                    i = i + 1
                }
                out = __str_concat(out, "\n")
                out = __str_concat(out, closepad)
                __str_concat(out, "}")
            }
        }
    }
}

// Like `stringify`, but multi-line with `indent` spaces per nesting level.
// Empty arrays and objects stay on one line as `[]` / `{}`.
fun stringify_pretty(value: JsonValue, indent: int) -> str {
    return stringify_pretty_at(value, indent, 0)
}

impl JsonValue {
    fun is_null(self) -> bool {
        return value_is_null(self)
    }

    fun as_bool(self) -> Option[bool] {
        return value_as_bool(self)
    }

    fun as_number(self) -> Option[float] {
        return value_as_number(self)
    }

    fun as_string(self) -> Option[str] {
        return value_as_string(self)
    }

    // Object member by key, or None when the value is not an object or the
    // key is absent.
    fun get(self, key: str) -> Option[JsonValue] {
        return object_get(self, key)
    }

    // Array element by index, or None when out of range or not an array.
    fun at(self, i: int) -> Option[JsonValue] {
        return array_at(self, i)
    }

    // The number truncated to an int, or None when not a number.
    fun as_int(self) -> Option[int] {
        return value_as_int(self)
    }

    // The keys of an object (empty for any other value).
    fun keys(self) -> list[str] {
        return value_keys(self)
    }

    // The element count of an array or object (0 for any other value).
    fun length(self) -> int {
        return value_length(self)
    }
}

fun value_is_null(value: JsonValue) -> bool {
    return match value {
        case Null { true }
        case _ { false }
    }
}

fun value_as_bool(value: JsonValue) -> Option[bool] {
    return match value {
        case Bool(b) { Some(b) }
        case _ { None }
    }
}

fun value_as_number(value: JsonValue) -> Option[float] {
    return match value {
        case Number(n) { Some(n) }
        case _ { None }
    }
}

fun value_as_int(value: JsonValue) -> Option[int] {
    return match value {
        case Number(n) { Some(raven_float_to_int(n)) }
        case _ { None }
    }
}

fun value_keys(value: JsonValue) -> list[str] {
    return match value {
        case Object(map) { map.keys() }
        case _ {
            let empty: list[str] = []
            empty
        }
    }
}

fun value_length(value: JsonValue) -> int {
    return match value {
        case Array(items) { items.len() }
        case Object(map) { map.len() }
        case _ { 0 }
    }
}

// Constructors for building a JsonValue programmatically (the inverse of the
// accessors), so a value can be assembled and then `stringify`d.
fun json_null() -> JsonValue {
    return JsonValue.Null
}

fun json_bool(b: bool) -> JsonValue {
    return JsonValue.Bool(b)
}

fun json_number(n: float) -> JsonValue {
    return JsonValue.Number(n)
}

fun json_int(n: int) -> JsonValue {
    return JsonValue.Number(raven_int_to_float(n))
}

fun json_string(s: str) -> JsonValue {
    return JsonValue.Str(s)
}

fun json_array(items: list[JsonValue]) -> JsonValue {
    return JsonValue.Array(items)
}

fun json_object(map: dict[str, JsonValue]) -> JsonValue {
    return JsonValue.Object(map)
}

fun value_as_string(value: JsonValue) -> Option[str] {
    return match value {
        case Str(s) { Some(s) }
        case _ { None }
    }
}

fun object_get(value: JsonValue, key: str) -> Option[JsonValue] {
    return match value {
        case Object(map) { map.get(key) }
        case _ { None }
    }
}

fun array_at(value: JsonValue, i: int) -> Option[JsonValue] {
    return match value {
        case Array(items) {
            if i < 0 {
                None
            } else if i >= items.len() {
                None
            } else {
                Some(items[i])
            }
        }
        case _ { None }
    }
}

// ----- JSON serialization traits -----
//
// `ToJson` turns a value into a `JsonValue`; pair it with `stringify` for a
// `str`. `FromJson` reads a `JsonValue` back, returning an `Error` when the
// shape does not match. `from_json` is an associated function: call it as
// `Point.from_json(j)` for a user type, or route a field through the generic
// `from_json_value` helper so the type parameter selects the impl.
//
// `@derive(ToJson, FromJson)` synthesizes these for user structs and enums.
// See docs/specs/derive.md for the struct/enum JSON encodings.

trait ToJson {
    fun to_json(self) -> JsonValue
}

trait FromJson {
    fun from_json(j: JsonValue) -> Result[Self, Error]
}

// Decode `j` as a `T`, with `T` chosen by the expected result type, so
// scalar, list, Option, and user-type members decode uniformly through one
// call (`T.from_json` dispatches on the type parameter). The built-in list
// and Option impls use it; a hand-written FromJson impl can too.
fun from_json_value[T: FromJson](j: JsonValue) -> Result[T, Error] {
    return T.from_json(j)
}

// Parse a JSON string and decode it into a `T` in one step. The element type is
// chosen by the call, so `decode[Point](text)` or a `Result[Point, Error]`
// annotation selects the impl. Returns an Err for malformed JSON or a shape that
// does not match `T`.
fun decode[T: FromJson](s: str) -> Result[T, Error] {
    return from_json_value(parse(s)?)
}

// Read object member `key`, or an Err when `j` is not an object or the key
// is absent. Useful in a hand-written `from_json` to fetch a field before
// decoding it (`@derive(FromJson)` emits its own equivalent helper).
fun json_field(j: JsonValue, key: str) -> Result[JsonValue, Error] {
    return match object_get(j, key) {
        case Some(v) { Ok(v) }
        case None { Err(json_error("missing field ".concat(key))) }
    }
}

// ----- Built-in ToJson/FromJson impls -----
//
// These bottom out field recursion. `int` and float both serialize to a JSON
// number; an int round-trips through float and loses precision beyond 2^53
// (the IEEE 754 double mantissa). `bool` maps to a JSON bool, str to a JSON
// string, list[T] to a JSON array, and Option[T] to null or the inner value.

impl ToJson for int {
    fun to_json(self) -> JsonValue {
        return JsonValue.Number(raven_int_to_float(self))
    }
}

impl FromJson for int {
    fun from_json(j: JsonValue) -> Result[int, Error] {
        return match j {
            case Number(n) { Ok(raven_float_to_int(n)) }
            case _ { Err(json_error("expected a number")) }
        }
    }
}

impl ToJson for float {
    fun to_json(self) -> JsonValue {
        return JsonValue.Number(self)
    }
}

impl FromJson for float {
    fun from_json(j: JsonValue) -> Result[float, Error] {
        return match j {
            case Number(n) { Ok(n) }
            case _ { Err(json_error("expected a number")) }
        }
    }
}

impl ToJson for bool {
    fun to_json(self) -> JsonValue {
        return JsonValue.Bool(self)
    }
}

impl FromJson for bool {
    fun from_json(j: JsonValue) -> Result[bool, Error] {
        return match j {
            case Bool(b) { Ok(b) }
            case _ { Err(json_error("expected a bool")) }
        }
    }
}

impl ToJson for str {
    fun to_json(self) -> JsonValue {
        return JsonValue.Str(self)
    }
}

impl FromJson for str {
    fun from_json(j: JsonValue) -> Result[str, Error] {
        return match j {
            case Str(s) { Ok(s) }
            case _ { Err(json_error("expected a string")) }
        }
    }
}

impl[T: ToJson] ToJson for list[T] {
    fun to_json(self) -> JsonValue {
        let items: list[JsonValue] = []
        var i = 0
        let n = self.len()
        while i < n {
            items.push(self[i].to_json())
            i = i + 1
        }
        return JsonValue.Array(items)
    }
}

impl[T: FromJson] FromJson for list[T] {
    fun from_json(j: JsonValue) -> Result[list[T], Error] {
        return list_from_json(j)
    }
}

// The list FromJson body lives in a free function: matching a `self`-less
// JsonValue payload and pushing decoded elements through the generic helper
// keeps the element type inference straightforward.
fun list_from_json[T: FromJson](j: JsonValue) -> Result[list[T], Error] {
    return match j {
        case Array(items) {
            var out: list[T] = []
            var i = 0
            let n = items.len()
            while i < n {
                let elem: T = from_json_value(items[i])?
                out.push(elem)
                i = i + 1
            }
            Ok(out)
        }
        case _ { Err(json_error("expected an array")) }
    }
}

impl[T: ToJson] ToJson for Option[T] {
    fun to_json(self) -> JsonValue {
        return match self {
            case Some(v) { v.to_json() }
            case None { JsonValue.Null }
        }
    }
}

impl[T: FromJson] FromJson for Option[T] {
    fun from_json(j: JsonValue) -> Result[Option[T], Error] {
        return option_from_json(j)
    }
}

fun option_from_json[T: FromJson](j: JsonValue) -> Result[Option[T], Error] {
    return match j {
        case Null { Ok(None) }
        case _ {
            var v: T = from_json_value(j)?
            Ok(Some(v))
        }
    }
}
