// std.error: an `Error` value type plus ergonomic helpers over the
// built-in `Result[T, E]`. Raven already has `Result`, `Option`, and the
// `?` operator; this module adds a carryable error with a message and
// optional kind, context chaining, and a few free functions over Result.

import std.string

class Error {
    kind: str
    message: str
}

// Construct an error with an empty kind.
fun error(msg: str) -> Error {
    return Error(kind: "", message: msg)
}

// Construct an error tagged with a kind (for example "io" or "parse").
fun error_kind(kind: str, msg: str) -> Error {
    return Error(kind: kind, message: msg)
}

impl Error {
    fun message(self) -> str {
        return self.message
    }

    fun kind(self) -> str {
        return self.kind
    }

    // A new error whose message is `ctx + ": " + message`, preserving the
    // kind. Use it to add a higher-level explanation to a lower-level
    // failure as it propagates.
    fun with_context(self, ctx: str) -> Error {
        return Error(kind: self.kind, message: ctx.concat(": ").concat(self.message))
    }
}

impl ToString for Error {
    fun to_string(self) -> str {
        if self.kind.length() == 0 {
            return self.message
        }
        return self.kind.concat(": ").concat(self.message)
    }
}

fun is_ok[T, E](r: Result[T, E]) -> bool {
    return match r {
        case Ok(v) { true }
        case Err(e) { false }
    }
}

fun is_err[T, E](r: Result[T, E]) -> bool {
    return match r {
        case Ok(v) { false }
        case Err(e) { true }
    }
}

// The Ok value, or `default` when the Result is an Err.
fun unwrap_or[T, E](r: Result[T, E], default: T) -> T {
    return match r {
        case Ok(v) { v }
        case Err(e) { default }
    }
}

// Discard the error, mapping Ok to Some and Err to None.
fun ok[T, E](r: Result[T, E]) -> Option[T] {
    return match r {
        case Ok(v) { Some(v) }
        case Err(e) { None }
    }
}

// Keep the error, mapping Err to Some and Ok to None.
fun err[T, E](r: Result[T, E]) -> Option[E] {
    return match r {
        case Ok(v) { None }
        case Err(e) { Some(e) }
    }
}

// Transform the `Ok` value with `f`, passing an `Err` through unchanged.
fun map_ok[T, U, E](r: Result[T, E], f: fun(T) -> U) -> Result[U, E] {
    return match r {
        case Ok(v) { Ok(f(v)) }
        case Err(e) { Err(e) }
    }
}

// Transform the `Err` value with `f`, passing an `Ok` through unchanged.
fun map_err[T, E, F](r: Result[T, E], f: fun(E) -> F) -> Result[T, F] {
    return match r {
        case Ok(v) { Ok(v) }
        case Err(e) { Err(f(e)) }
    }
}

// The `Ok` value, or the result of applying `f` to the error. The lazy
// counterpart to `unwrap_or`, useful when the fallback is expensive.
fun unwrap_or_else[T, E](r: Result[T, E], f: fun(E) -> T) -> T {
    return match r {
        case Ok(v) { v }
        case Err(e) { f(e) }
    }
}
