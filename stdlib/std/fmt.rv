// std/fmt: string formatting helpers and a Debug trait. Padding widths
// count UTF-8 bytes, matching the byte-oriented String model. There is no
// printf-style format function: string interpolation "${expr}" is the
// placeholder mechanism, and these are the building blocks. See
// docs/specs/std-fmt.md.

import std.string
from std.math import floor, fabs

// `s` repeated `n` times. A non-positive `n` yields the empty string.
fun repeat(s: str, n: int) -> str {
    var out = ""
    var i = 0
    while i < n {
        out = __str_concat(out, s)
        i = i + 1
    }
    return out
}

// Repeat `fill` just enough whole times to span at least `width` bytes. A
// non-positive width or an empty fill yields the empty string. The result
// overshoots `width` by at most fill.len() - 1 bytes.
fun fill_span(width: int, fill: str) -> str {
    if width <= 0 {
        return ""
    }
    let flen = __str_len(fill)
    if flen == 0 {
        return ""
    }
    var copies = width / flen
    if copies * flen < width {
        copies = copies + 1
    }
    return repeat(fill, copies)
}

// Left-pad `s` with `fill` until its byte length is at least `width`. A
// multi-byte `fill` overshoots by at most its length minus one. `width` is
// compared before any subtraction so a very negative width cannot wrap.
fun pad_left(s: str, width: int, fill: str) -> str {
    let len = __str_len(s)
    if width <= len {
        return s
    }
    return __str_concat(fill_span(width - len, fill), s)
}

// Right-pad `s` with `fill` until its byte length is at least `width`.
fun pad_right(s: str, width: int, fill: str) -> str {
    let len = __str_len(s)
    if width <= len {
        return s
    }
    return __str_concat(s, fill_span(width - len, fill))
}

// Center `s` in a field of byte width `width`, padding with `fill`. An
// odd amount of padding puts the extra byte on the right.
fun center(s: str, width: int, fill: str) -> str {
    let len = __str_len(s)
    if width <= len {
        return s
    }
    let pad = width - len
    let left = pad / 2
    let right = pad - left
    return __str_concat(__str_concat(fill_span(left, fill), s), fill_span(right, fill))
}

// Join `parts` with `sep` between adjacent elements.
fun join(parts: list[str], sep: str) -> str {
    let n = parts.len()
    var out = ""
    var i = 0
    while i < n {
        if i > 0 {
            out = __str_concat(out, sep)
        }
        out = __str_concat(out, parts[i])
        i = i + 1
    }
    return out
}

// Map a 0..15 digit value to its lowercase digit byte (0-9, a-f).
fun radix_digit(v: int) -> int {
    if v < 10 {
        return 48 + v
    }
    return 87 + v
}

// `n` written in `base`, with a leading '-' for negatives. `base` must be
// in 2..=16; out of range returns the empty string. Zero is "0". The most
// negative i64 is handled by accumulating the negative magnitude so no
// overflow occurs on negation.
fun to_radix(n: int, base: int) -> str {
    if base < 2 {
        return ""
    }
    if base > 16 {
        return ""
    }
    if n == 0 {
        return "0"
    }
    var neg = n < 0
    // Work in the negative domain so INT_MIN has no overflowing negation.
    var m = n
    if m > 0 {
        m = 0 - m
    }
    var out = ""
    while m < 0 {
        let d = 0 - (m % base)
        out = __str_concat(__str_from_byte(radix_digit(d)), out)
        m = m / base
    }
    if neg {
        out = __str_concat("-", out)
    }
    return out
}

fun to_binary(n: int) -> str {
    return to_radix(n, 2)
}

fun to_octal(n: int) -> str {
    return to_radix(n, 8)
}

fun to_hex(n: int) -> str {
    return to_radix(n, 16)
}

// The numeric value of a base digit byte (0-9, a-f, A-F), or -1 when it is
// not a digit.
fun radix_value(b: int) -> int {
    if b >= 48 {
        if b <= 57 {
            return b - 48
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87
        }
    }
    if b >= 65 {
        if b <= 70 {
            return b - 55
        }
    }
    return -1
}

// Parse `s` as an integer in `base` (2..=16), with an optional leading sign.
// Returns `None` on an empty string, a bad digit, or an out-of-range `base`.
// The inverse of `to_radix`.
fun from_radix(s: str, base: int) -> Option[int] {
    if base < 2 {
        return None
    }
    if base > 16 {
        return None
    }
    let n = __str_len(s)
    if n == 0 {
        return None
    }
    var i = 0
    var neg = false
    let b0 = __str_byte_at(s, 0)
    if b0 == 45 {
        neg = true
        i = 1
    } else {
        if b0 == 43 {
            i = 1
        }
    }
    if i >= n {
        return None
    }
    let max = 9223372036854775807
    let min = 0 - 9223372036854775807 - 1
    // Accumulate toward the sign's own end of the range so the running value
    // never has to leave it. A negative number builds down toward min, which
    // also lets the most negative i64 parse. Each step checks for overflow
    // before it happens and returns None instead of wrapping.
    var acc = 0
    while i < n {
        let v = radix_value(__str_byte_at(s, i))
        if v < 0 {
            return None
        }
        if v >= base {
            return None
        }
        if neg {
            if acc < (min + v) / base {
                return None
            }
            acc = acc * base - v
        } else {
            if acc > (max - v) / base {
                return None
            }
            acc = acc * base + v
        }
        i = i + 1
    }
    return Some(acc)
}

// Parse a hexadecimal string into an integer. The inverse of `to_hex`.
fun from_hex(s: str) -> Option[int] {
    return from_radix(s, 16)
}

// Map a float digit (0.0..9.0) to its character, with no Int conversion.
fun float_digit_char(d: float) -> str {
    if d < 0.5 {
        return "0"
    }
    if d < 1.5 {
        return "1"
    }
    if d < 2.5 {
        return "2"
    }
    if d < 3.5 {
        return "3"
    }
    if d < 4.5 {
        return "4"
    }
    if d < 5.5 {
        return "5"
    }
    if d < 6.5 {
        return "6"
    }
    if d < 7.5 {
        return "7"
    }
    if d < 8.5 {
        return "8"
    }
    return "9"
}

// Format `x` with exactly `decimals` digits after the decimal point when the
// requested scale stays finite, rounded half up. `format_float(3.14159, 2)` is
// "3.14"; `format_float(-2.5, 0)` is "-3". Excessive precision is clamped
// before the scale or scaled value would become infinite.
fun format_float(x: float, decimals: int) -> str {
    // Non-finite values have no decimal form: NaN compares false everywhere
    // (so the scaling loop would never run and pad to "0.00") and infinity
    // never falls below 1.0 (so the digit loop would spin forever). `x != x`
    // is true only for NaN; `x * 0.0` is NaN for an infinity and 0 otherwise.
    if x != x {
        return "NaN"
    }
    if x * 0.0 != 0.0 {
        if x < 0.0 {
            return "-inf"
        }
        return "inf"
    }
    var neg = x < 0.0
    let v = fabs(x)
    var places = decimals
    if places < 0 {
        places = 0
    }
    var scale = 1.0
    var i = 0
    while i < places {
        let next = scale * 10.0
        if next * 0.0 != 0.0 {
            places = i
        } else if (v * next) * 0.0 != 0.0 {
            places = i
        } else {
            scale = next
            i = i + 1
        }
    }
    let scaled = floor(v * scale + 0.5)
    var digits = ""
    var count = 0
    if scaled < 1.0 {
        digits = "0"
        count = 1
    } else {
        var w = scaled
        while w >= 1.0 {
            let last = w - floor(w / 10.0) * 10.0
            digits = __str_concat(float_digit_char(last), digits)
            w = floor(w / 10.0)
            count = count + 1
        }
    }
    while count <= places {
        digits = __str_concat("0", digits)
        count = count + 1
    }
    var result = ""
    if places <= 0 {
        result = digits
    } else {
        let cut = count - places
        let int_part = digits.substring(0, cut)
        let frac_part = digits.substring(cut, count)
        result = __str_concat(__str_concat(int_part, "."), frac_part)
    }
    if neg {
        result = __str_concat("-", result)
    }
    return result
}

// Decimal `n` zero-padded to byte width `width`. For a negative `n` the
// '-' stays leftmost and the zero fill goes between the sign and the
// digits, so pad_int(-7, 4) is "-007".
fun pad_int(n: int, width: int) -> str {
    if n < 0 {
        // Render through `to_string` and strip the leading '-' rather than
        // negating, which overflows (and stays negative) at Int::MIN, producing
        // a doubled minus sign.
        let s = n.to_string()
        var digits = s.substring(1, s.length())
        return __str_concat("-", pad_left(digits, width - 1, "0"))
    }
    return pad_left(n.to_string(), width, "0")
}

trait Debug {
    fun debug(self) -> str
}

impl Debug for int {
    fun debug(self) -> str = self.to_string()
}

impl Debug for float {
    fun debug(self) -> str = self.to_string()
}

impl Debug for bool {
    fun debug(self) -> str = self.to_string()
}

// Quoted with single quotes. Inner quotes are not escaped.
impl Debug for char {
    fun debug(self) -> str {
        return __str_concat(__str_concat("'", self.to_string()), "'")
    }
}

// Quoted with double quotes. Inner quotes are not escaped.
impl Debug for str {
    fun debug(self) -> str {
        return __str_concat(__str_concat("\"", self), "\"")
    }
}
