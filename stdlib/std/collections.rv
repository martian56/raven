// std/collections: hash-backed `set[T]` and `dict[K, V]` over keys that
// implement `Eq + Hash`.
//
// Both keep their items in dense lists in insertion order (so iteration
// follows insertion order) and find them through an open-addressed index
// table of positions into those lists, probed linearly from a mixed hash.
// The table holds -1 for an empty slot and -2 for a removed one, and doubles
// once it is three quarters used. Removal moves the last item into the hole.

// Spread a key hash over the table. Int hashes are the value itself, so
// sequential keys would otherwise cluster.
fun _mix(h: int) -> int {
    let x = h * -7046029254386353131
    return x ^ (x >> 29)
}

fun _empty_slots(n: int) -> list[int] {
    let slots: list[int] = []
    var i = 0
    while i < n {
        slots.push(-1)
        i += 1
    }
    return slots
}

class Set[T: Eq + Hash] {
    items: list[T]
    hashes: list[int]
    slots: list[int]
    used: int
}

// Superseded by set literals `{1, 2}` and `set()`. Kept for selective imports.
fun empty_set[T: Eq + Hash]() -> set[T] {
    return Set.new()
}

impl[T: Eq + Hash] set[T] {
    fun new() -> set[T] {
        let items: list[T] = []
        let hashes: list[int] = []
        return Set(items: items, hashes: hashes, slots: _empty_slots(8), used: 0)
    }

    fun len(self) -> int {
        return self.items.len()
    }

    fun is_empty(self) -> bool {
        return self.items.len() == 0
    }

    // The items in insertion order.
    fun to_list(self) -> list[T] {
        let out: list[T] = []
        for x in self.items {
            out.push(x)
        }
        return out
    }

    fun union(self, other: set[T]) -> set[T] {
        let out: set[T] = Set.new()
        for x in self.items {
            out.add(x)
        }
        for x in other.items {
            out.add(x)
        }
        return out
    }

    fun intersection(self, other: set[T]) -> set[T] {
        let out: set[T] = Set.new()
        for x in self.items {
            if other.contains(x) {
                out.add(x)
            }
        }
        return out
    }

    fun difference(self, other: set[T]) -> set[T] {
        let out: set[T] = Set.new()
        for x in self.items {
            if not other.contains(x) {
                out.add(x)
            }
        }
        return out
    }

    fun is_subset(self, other: set[T]) -> bool {
        for x in self.items {
            if not other.contains(x) {
                return false
            }
        }
        return true
    }

    // The table slot holding `x`, or -1.
    fun _find(self, x: T, h: int) -> int {
        let mask = self.slots.len() - 1
        var i = _mix(h) & mask
        loop {
            let s = self.slots[i]
            if s == -1 {
                return -1
            }
            if s >= 0 and self.hashes[s] == h and self.items[s].equals(x) {
                return i
            }
            i = (i + 1) & mask
        }
    }

    fun contains(self, x: T) -> bool {
        return self._find(x, x.hash()) >= 0
    }

    // Add `x` if it is not already present.
    fun add(self, x: T) {
        let h = x.hash()
        let mask = self.slots.len() - 1
        var i = _mix(h) & mask
        var free = -1
        loop {
            let s = self.slots[i]
            if s == -1 {
                break
            }
            if s == -2 {
                if free < 0 {
                    free = i
                }
            } else if self.hashes[s] == h and self.items[s].equals(x) {
                return
            }
            i = (i + 1) & mask
        }
        if free >= 0 {
            i = free
        } else {
            self.used += 1
        }
        self.slots[i] = self.items.len()
        self.items.push(x)
        self.hashes.push(h)
        if self.used * 4 >= self.slots.len() * 3 {
            self._grow()
        }
    }

    // Remove `x`; true when it was present.
    fun remove(self, x: T) -> bool {
        let h = x.hash()
        let slot = self._find(x, h)
        if slot < 0 {
            return false
        }
        let idx = self.slots[slot]
        self.slots[slot] = -2
        let last = self.items.len() - 1
        if idx != last {
            let moved = self.items[last]
            let moved_hash = self.hashes[last]
            let at = self._find(moved, moved_hash)
            self.slots[at] = idx
            self.items[idx] = moved
            self.hashes[idx] = moved_hash
        }
        self.items.pop()
        self.hashes.pop()
        return true
    }

    fun _grow(self) {
        var n = self.slots.len() * 2
        while self.items.len() * 2 >= n {
            n *= 2
        }
        let slots = _empty_slots(n)
        let mask = n - 1
        var idx = 0
        while idx < self.items.len() {
            var i = _mix(self.hashes[idx]) & mask
            while slots[i] != -1 {
                i = (i + 1) & mask
            }
            slots[i] = idx
            idx += 1
        }
        self.slots = slots
        self.used = self.items.len()
    }
}

class Entry[K, V] {
    key: K
    value: V
}

class Map[K: Eq + Hash, V] {
    keys_: list[K]
    vals: list[V]
    hashes: list[int]
    slots: list[int]
    used: int
}

// Superseded by dict literals `{"a": 1}` and `{}`. Kept for selective imports.
fun empty_map[K: Eq + Hash, V]() -> dict[K, V] {
    return Map.new()
}

impl[K: Eq + Hash, V] dict[K, V] {
    fun new() -> dict[K, V] {
        let keys_: list[K] = []
        let vals: list[V] = []
        let hashes: list[int] = []
        return Map(keys_: keys_, vals: vals, hashes: hashes, slots: _empty_slots(8), used: 0)
    }

    fun len(self) -> int {
        return self.keys_.len()
    }

    fun is_empty(self) -> bool {
        return self.keys_.len() == 0
    }

    fun get_or(self, k: K, default: V) -> V {
        let slot = self._find(k, k.hash())
        if slot < 0 {
            return default
        }
        return self.vals[self.slots[slot]]
    }

    // The entries in insertion order.
    fun entries(self) -> list[Entry[K, V]] {
        let out: list[Entry[K, V]] = []
        var i = 0
        while i < self.keys_.len() {
            out.push(Entry(key: self.keys_[i], value: self.vals[i]))
            i += 1
        }
        return out
    }

    fun clear(self) {
        let keys_: list[K] = []
        let vals: list[V] = []
        let hashes: list[int] = []
        self.keys_ = keys_
        self.vals = vals
        self.hashes = hashes
        self.slots = _empty_slots(8)
        self.used = 0
    }

    // The table slot holding `k`, or -1.
    fun _find(self, k: K, h: int) -> int {
        let mask = self.slots.len() - 1
        var i = _mix(h) & mask
        loop {
            let s = self.slots[i]
            if s == -1 {
                return -1
            }
            if s >= 0 and self.hashes[s] == h and self.keys_[s].equals(k) {
                return i
            }
            i = (i + 1) & mask
        }
    }

    fun has(self, k: K) -> bool {
        return self._find(k, k.hash()) >= 0
    }

    fun get(self, k: K) -> Option[V] {
        let slot = self._find(k, k.hash())
        if slot < 0 {
            return None
        }
        return Some(self.vals[self.slots[slot]])
    }

    // Insert `k` with `v`, or overwrite the value if `k` is present.
    fun set(self, k: K, v: V) {
        let h = k.hash()
        let mask = self.slots.len() - 1
        var i = _mix(h) & mask
        var free = -1
        loop {
            let s = self.slots[i]
            if s == -1 {
                break
            }
            if s == -2 {
                if free < 0 {
                    free = i
                }
            } else if self.hashes[s] == h and self.keys_[s].equals(k) {
                self.vals[s] = v
                return
            }
            i = (i + 1) & mask
        }
        if free >= 0 {
            i = free
        } else {
            self.used += 1
        }
        self.slots[i] = self.keys_.len()
        self.keys_.push(k)
        self.vals.push(v)
        self.hashes.push(h)
        if self.used * 4 >= self.slots.len() * 3 {
            self._grow()
        }
    }

    // The keys in insertion order.
    fun keys(self) -> list[K] {
        let out: list[K] = []
        for k in self.keys_ {
            out.push(k)
        }
        return out
    }

    // The values in insertion order.
    fun values(self) -> list[V] {
        let out: list[V] = []
        for v in self.vals {
            out.push(v)
        }
        return out
    }

    // Remove `k`; true when it was present.
    fun remove(self, k: K) -> bool {
        let h = k.hash()
        let slot = self._find(k, h)
        if slot < 0 {
            return false
        }
        let idx = self.slots[slot]
        self.slots[slot] = -2
        let last = self.keys_.len() - 1
        if idx != last {
            let moved = self.keys_[last]
            let moved_hash = self.hashes[last]
            let at = self._find(moved, moved_hash)
            self.slots[at] = idx
            self.keys_[idx] = moved
            self.vals[idx] = self.vals[last]
            self.hashes[idx] = moved_hash
        }
        self.keys_.pop()
        self.vals.pop()
        self.hashes.pop()
        return true
    }

    fun _grow(self) {
        var n = self.slots.len() * 2
        while self.keys_.len() * 2 >= n {
            n *= 2
        }
        let slots = _empty_slots(n)
        let mask = n - 1
        var idx = 0
        while idx < self.keys_.len() {
            var i = _mix(self.hashes[idx]) & mask
            while slots[i] != -1 {
                i = (i + 1) & mask
            }
            slots[i] = idx
            idx += 1
        }
        self.slots = slots
        self.used = self.keys_.len()
    }
}

// ----- Eq: `==`/`!=` compare by value -----

impl[T: Eq + Hash] Eq for set[T] {
    fun equals(self, other: set[T]) -> bool {
        return self.len() == other.len() and self.is_subset(other)
    }
}

impl[K: Eq + Hash, V: Eq] Eq for dict[K, V] {
    fun equals(self, other: dict[K, V]) -> bool {
        if self.len() != other.len() {
            return false
        }
        let ks = self.keys()
        var i = 0
        while i < ks.len() {
            let k = ks.get(i)
            if not self.get(k).equals(other.get(k)) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

// ----- ToString -----

impl[K: Eq + Hash + ToString, V: ToString] ToString for dict[K, V] {
    fun to_string(self) -> str {
        var out = "{"
        var first = true
        for e in self.entries() {
            if not first {
                out = out + ", "
            }
            first = false
            out = out + e.key.to_string() + ": " + e.value.to_string()
        }
        return out + "}"
    }
}

impl[T: Eq + Hash + ToString] ToString for set[T] {
    fun to_string(self) -> str {
        var out = "{"
        var first = true
        for x in self.to_list() {
            if not first {
                out = out + ", "
            }
            first = false
            out = out + x.to_string()
        }
        return out + "}"
    }
}
