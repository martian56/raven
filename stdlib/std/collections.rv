// std/collections: hash-backed Set and Map over keys that implement
// `Eq + Hash`.
//
// Storage is an array of buckets (a `List` of `List`s). A key is placed
// in `bucket_index(key) = ((key.hash() % n) + n) % n`, where `n` is the
// bucket count; the double-modulo keeps the index non-negative even when
// `hash()` returns a negative `Int` (the `Int` hash is the value itself,
// and the `String` hash can overflow). Lookup, insert, and remove hash
// the key, then linearly scan the one matching bucket with `Eq`, which is
// O(1) average. The table starts with 8 buckets and doubles, rehashing
// every entry, once the load factor (count / bucket count) passes 0.75.
//
// `Hash` is implemented for Int, Bool, and String (see std/core); any user
// type with `Eq + Hash` impls works as a key. Char and Float do not yet
// implement `Hash`, so they cannot be keys. `List<T>` is built into the
// language and needs no import.

class Set[T: Eq + Hash] {
    buckets: list[list[T]]
    count: int
}

// Superseded by the set literal `{a, b}` and `Set.new()`. Kept for
// selective imports.
fun empty_set[T: Eq + Hash]() -> set[T] {
    return Set.new()
}

impl[T: Eq + Hash] set[T] {
    fun new() -> set[T] {
        let buckets: list[list[T]] = []
        var i = 0
        while i < 8 {
            let b: list[T] = []
            buckets.push(b)
            i = i + 1
        }
        return Set(buckets: buckets, count: 0)
    }

    fun len(self) -> int {
        return self.count
    }

    fun is_empty(self) -> bool {
        return self.count == 0
    }

    // Every element of the set as a list, in no particular order. This is the
    // way to enumerate a set's contents.
    fun to_list(self) -> list[T] {
        var out: list[T] = []
        var i = 0
        while i < self.buckets.len() {
            let bucket = self.buckets[i]
            var j = 0
            while j < bucket.len() {
                out.push(bucket[j])
                j = j + 1
            }
            i = i + 1
        }
        return out
    }

    // A new set with every element of either set.
    fun union(self, other: set[T]) -> set[T] {
        var out: set[T] = Set.new()
        let a = self.to_list()
        var i = 0
        while i < a.len() {
            out.add(a[i])
            i = i + 1
        }
        let b = other.to_list()
        var j = 0
        while j < b.len() {
            out.add(b[j])
            j = j + 1
        }
        return out
    }

    // A new set with the elements present in both sets.
    fun intersection(self, other: set[T]) -> set[T] {
        var out: set[T] = Set.new()
        let a = self.to_list()
        var i = 0
        while i < a.len() {
            if other.contains(a[i]) {
                out.add(a[i])
            }
            i = i + 1
        }
        return out
    }

    // A new set with the elements in this set but not in `other`.
    fun difference(self, other: set[T]) -> set[T] {
        var out: set[T] = Set.new()
        let a = self.to_list()
        var i = 0
        while i < a.len() {
            if other.contains(a[i]) == false {
                out.add(a[i])
            }
            i = i + 1
        }
        return out
    }

    // True when every element of this set is also in `other`.
    fun is_subset(self, other: set[T]) -> bool {
        let a = self.to_list()
        var i = 0
        while i < a.len() {
            if other.contains(a[i]) == false {
                return false
            }
            i = i + 1
        }
        return true
    }

    fun bucket_index(self, x: T) -> int {
        let n = self.buckets.len()
        let h = x.hash() % n
        return (h + n) % n
    }

    fun contains(self, x: T) -> bool {
        let bucket = self.buckets[self.bucket_index(x)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].equals(x) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // Add `x` if it is not already present.
    fun add(self, x: T) {
        let bucket = self.buckets[self.bucket_index(x)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].equals(x) {
                return
            }
            i = i + 1
        }
        bucket.push(x)
        self.count = self.count + 1
        if self.count * 4 > self.buckets.len() * 3 {
            self.grow()
        }
    }

    // Remove `x` if present, returning whether it was. Order within a
    // bucket is not preserved: the last entry fills the removed slot.
    fun remove(self, x: T) -> bool {
        let bucket = self.buckets[self.bucket_index(x)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].equals(x) {
                let last = bucket.len() - 1
                bucket[i] = bucket[last]
                bucket.pop()
                self.count = self.count - 1
                return true
            }
            i = i + 1
        }
        return false
    }

    fun grow(self) {
        let new_count = self.buckets.len() * 2
        let fresh: list[list[T]] = []
        var i = 0
        while i < new_count {
            let b: list[T] = []
            fresh.push(b)
            i = i + 1
        }
        var bi = 0
        let nb = self.buckets.len()
        while bi < nb {
            let bucket = self.buckets[bi]
            var j = 0
            let m = bucket.len()
            while j < m {
                let x = bucket[j]
                let h = x.hash() % new_count
                let target = (h + new_count) % new_count
                fresh[target].push(x)
                j = j + 1
            }
            bi = bi + 1
        }
        self.buckets = fresh
    }
}

class Entry[K, V] {
    key: K
    value: V
}

class Map[K: Eq + Hash, V] {
    buckets: list[list[Entry[K, V]]]
    count: int
}

// Superseded by the map literal `["a": 1]` (and `[:]`) and `Map.new()`.
// Kept for selective imports.
fun empty_map[K: Eq + Hash, V]() -> dict[K, V] {
    return Map.new()
}

impl[K: Eq + Hash, V] dict[K, V] {
    fun new() -> dict[K, V] {
        let buckets: list[list[Entry[K, V]]] = []
        var i = 0
        while i < 8 {
            let b: list[Entry[K, V]] = []
            buckets.push(b)
            i = i + 1
        }
        return Map(buckets: buckets, count: 0)
    }

    fun len(self) -> int {
        return self.count
    }

    fun is_empty(self) -> bool {
        return self.count == 0
    }

    // The value for `k`, or `default` when the key is absent.
    fun get_or(self, k: K, default: V) -> V {
        return match self.get(k) {
            case Some(v) { v }
            case None { default }
        }
    }

    // Every key/value pair as a list of `Entry`, in no particular order.
    fun entries(self) -> list[Entry[K, V]] {
        var out: list[Entry[K, V]] = []
        var i = 0
        while i < self.buckets.len() {
            let bucket = self.buckets[i]
            var j = 0
            while j < bucket.len() {
                out.push(bucket[j])
                j = j + 1
            }
            i = i + 1
        }
        return out
    }

    // Remove every entry, leaving an empty map.
    fun clear(self) {
        let buckets: list[list[Entry[K, V]]] = []
        var i = 0
        while i < 8 {
            let b: list[Entry[K, V]] = []
            buckets.push(b)
            i = i + 1
        }
        self.buckets = buckets
        self.count = 0
    }

    fun bucket_index(self, k: K) -> int {
        let n = self.buckets.len()
        let h = k.hash() % n
        return (h + n) % n
    }

    fun has(self, k: K) -> bool {
        let bucket = self.buckets[self.bucket_index(k)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].key.equals(k) {
                return true
            }
            i = i + 1
        }
        return false
    }

    fun get(self, k: K) -> Option[V] {
        let bucket = self.buckets[self.bucket_index(k)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].key.equals(k) {
                return Some(bucket[i].value)
            }
            i = i + 1
        }
        return None
    }

    // Insert `k` with `v`, or overwrite the value if `k` is present.
    fun set(self, k: K, v: V) {
        let bucket = self.buckets[self.bucket_index(k)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].key.equals(k) {
                bucket[i].value = v
                return
            }
            i = i + 1
        }
        bucket.push(Entry(key: k, value: v))
        self.count = self.count + 1
        if self.count * 4 > self.buckets.len() * 3 {
            self.grow()
        }
    }

    // All keys across every bucket, in unspecified order.
    fun keys(self) -> list[K] {
        var out: list[K] = []
        var bi = 0
        let nb = self.buckets.len()
        while bi < nb {
            let bucket = self.buckets[bi]
            var j = 0
            let m = bucket.len()
            while j < m {
                out.push(bucket[j].key)
                j = j + 1
            }
            bi = bi + 1
        }
        return out
    }

    // All values across every bucket, in the same order as `keys()`.
    fun values(self) -> list[V] {
        var out: list[V] = []
        var bi = 0
        let nb = self.buckets.len()
        while bi < nb {
            let bucket = self.buckets[bi]
            var j = 0
            let m = bucket.len()
            while j < m {
                out.push(bucket[j].value)
                j = j + 1
            }
            bi = bi + 1
        }
        return out
    }

    // Remove `k` if present, returning whether it was. Order within a
    // bucket is not preserved.
    fun remove(self, k: K) -> bool {
        let bucket = self.buckets[self.bucket_index(k)]
        var i = 0
        let n = bucket.len()
        while i < n {
            if bucket[i].key.equals(k) {
                let last = bucket.len() - 1
                bucket[i] = bucket[last]
                bucket.pop()
                self.count = self.count - 1
                return true
            }
            i = i + 1
        }
        return false
    }

    fun grow(self) {
        let new_count = self.buckets.len() * 2
        let fresh: list[list[Entry[K, V]]] = []
        var i = 0
        while i < new_count {
            let b: list[Entry[K, V]] = []
            fresh.push(b)
            i = i + 1
        }
        var bi = 0
        let nb = self.buckets.len()
        while bi < nb {
            let bucket = self.buckets[bi]
            var j = 0
            let m = bucket.len()
            while j < m {
                let e = bucket[j]
                let h = e.key.hash() % new_count
                let target = (h + new_count) % new_count
                fresh[target].push(e)
                j = j + 1
            }
            bi = bi + 1
        }
        self.buckets = fresh
    }
}

// ----- Eq: `==`/`!=` compare by value -----

impl[T: Eq + Hash] Eq for set[T] {
    fun equals(self, other: set[T]) -> bool {
        return self.len() == other.len() and self.is_subset(other)
    }
}

impl[K: Eq + Hash, V: Eq] Eq for dict[K, V] {
    fun equals(self, other: dict[K, V]) -> bool {
        if self.len() != other.len() {
            return false
        }
        let ks = self.keys()
        var i = 0
        while i < ks.len() {
            let k = ks.get(i)
            if not self.get(k).equals(other.get(k)) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

// ----- ToString -----

impl[K: Eq + Hash + ToString, V: ToString] ToString for dict[K, V] {
    fun to_string(self) -> str {
        var out = "{"
        var first = true
        for e in self.entries() {
            if not first {
                out = out + ", "
            }
            first = false
            out = out + e.key.to_string() + ": " + e.value.to_string()
        }
        return out + "}"
    }
}

impl[T: Eq + Hash + ToString] ToString for set[T] {
    fun to_string(self) -> str {
        var out = "{"
        var first = true
        for x in self.to_list() {
            if not first {
                out = out + ", "
            }
            first = false
            out = out + x.to_string()
        }
        return out + "}"
    }
}
