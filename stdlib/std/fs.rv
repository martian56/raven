// std.fs: filesystem operations over the raven-runtime C ABI. Fallible
// ops return Result[T, Error] where the error is an std.error `Error`
// tagged with kind "io" (Raven has no type alias, so IoError is realized
// as that, built through std.error's `error_kind("io", ...)`).
// The runtime keeps a thread-local last-error string; each
// wrapper runs the op and turns a non-empty last error into an Err. The
// non-fallible queries (exists, is_file, is_dir) treat a missing path as a
// normal false. Path manipulation is pure Raven string work on `/`. See
// docs/guide/stdlib/fs.md.

from std.error import error_kind
import std.string

extern "C" {
    fun raven_fs_last_error() -> str
    fun raven_fs_read(path: str) -> str
    fun raven_fs_write(path: str, contents: str) -> bool
    fun raven_fs_append(path: str, contents: str) -> bool
    fun raven_fs_remove_file(path: str) -> bool
    fun raven_fs_create_dir(path: str) -> bool
    fun raven_fs_remove_dir(path: str) -> bool
    fun raven_fs_list(path: str) -> str
    fun raven_fs_size(path: str) -> int
    fun raven_fs_exists(path: str) -> bool
    fun raven_fs_is_file(path: str) -> bool
    fun raven_fs_is_dir(path: str) -> bool
    fun raven_fs_is_symlink(path: str) -> bool
}

// An Error tagged with kind "io" (the IoError realization), its message a
// context prefix joined to the runtime's last-error text.
fun io_error(ctx: str) -> Error {
    return error_kind("io", ctx.concat(": ").concat(raven_fs_last_error()))
}

// Whole file at `path` as a str.
fun read(path: str) -> Result[str, Error] {
    let out = raven_fs_read(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("read ${path}"))
    }
    return Ok(out)
}

// Create or truncate `path` and write `contents`. Returns Ok(true) on
// success; the bool payload is always true and exists only because the
// surface uses Result[bool, Error] rather than a Unit payload.
fun write(path: str, contents: str) -> Result[bool, Error] {
    raven_fs_write(path, contents)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("write ${path}"))
    }
    return Ok(true)
}

// Append `contents` to `path`, creating it when absent. Ok(true) on success.
fun append(path: str, contents: str) -> Result[bool, Error] {
    raven_fs_append(path, contents)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("append ${path}"))
    }
    return Ok(true)
}

// Remove the file at `path`. Ok(true) on success.
fun remove_file(path: str) -> Result[bool, Error] {
    raven_fs_remove_file(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("remove_file ${path}"))
    }
    return Ok(true)
}

// Create the directory at `path`, including any missing parents. Ok(true)
// on success.
fun create_dir(path: str) -> Result[bool, Error] {
    raven_fs_create_dir(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("create_dir ${path}"))
    }
    return Ok(true)
}

// Remove the directory at `path` and all of its contents. Ok(true) on
// success.
fun remove_dir(path: str) -> Result[bool, Error] {
    raven_fs_remove_dir(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("remove_dir ${path}"))
    }
    return Ok(true)
}

// Entry names (not full paths) of the directory at `path`. An empty
// directory yields an empty list.
fun list_dir(path: str) -> Result[list[str], Error] {
    let joined = raven_fs_list(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("list_dir ${path}"))
    }
    // Names are joined by a NUL byte, which cannot appear in a filename, so a
    // name containing a newline is not split and a non-UTF-8 name is preserved.
    if joined.length() == 0 {
        let empty: list[str] = []
        return Ok(empty)
    }
    return Ok(joined.split(__str_from_byte(0)))
}

// File size at `path` in bytes.
fun size(path: str) -> Result[int, Error] {
    let n = raven_fs_size(path)
    if raven_fs_last_error().length() > 0 {
        return Err(io_error("size ${path}"))
    }
    return Ok(n)
}

// Whether anything exists at `path`. A missing path is a normal false.
fun exists(path: str) -> bool {
    return raven_fs_exists(path)
}

// Whether `path` is a regular file. A missing path is false.
fun is_file(path: str) -> bool {
    return raven_fs_is_file(path)
}

// Whether `path` is a directory. A missing path is false.
fun is_dir(path: str) -> bool {
    return raven_fs_is_dir(path)
}

// True when `path` itself is a symbolic link. This does not follow the link, so
// unlike `is_dir` it reports on the link rather than its target.
fun is_symlink(path: str) -> bool {
    return raven_fs_is_symlink(path)
}

// Create `path` and every missing parent directory, like `mkdir -p`. An
// already-existing directory in the chain is not an error. The OS resolves the
// path: splitting and rebuilding it in Raven mishandled a Windows UNC path
// (`//server/share`), rebuilding it as `/server/share` rooted on the current
// drive, so the whole path is handed to `create_dir`, which already creates
// every missing parent.
fun create_dir_all(path: str) -> Result[bool, Error] {
    return create_dir(path)
}

// Read a whole file and split it into lines (handling CRLF).
fun read_lines(path: str) -> Result[list[str], Error] {
    let content = read(path)?
    return Ok(content.lines())
}

// Copy the contents of `src` to `dst`, creating or truncating `dst`.
fun copy(src: str, dst: str) -> Result[bool, Error] {
    let content = read(src)?
    return write(dst, content)
}

// Recursively list every path under `path`, directories included, in
// depth-first order. Each entry is the full path joined from `path`.
fun walk(path: str) -> Result[list[str], Error] {
    let out: list[str] = []
    let entries = list_dir(path)?
    var i = 0
    while i < entries.len() {
        let full = join(path, entries.get(i))
        out.push(full)
        // Descend into real subdirectories only. A symlinked directory is
        // listed but not followed, so a link that points back up the tree
        // cannot send the walk into an endless loop.
        if is_dir(full) and not is_symlink(full) {
            let sub = walk(full)?
            var j = 0
            while j < sub.len() {
                out.push(sub.get(j))
                j = j + 1
            }
        }
        i = i + 1
    }
    return Ok(out)
}

// Split `s` on `\n` into a list of lines. An empty string yields an empty
// `list` (not a one-element list of ""), so an empty directory listing maps
// to an empty list.
fun split_lines(s: str) -> list[str] {
    let out: list[str] = []
    if s.length() == 0 {
        return out
    }
    let n = s.length()
    var start = 0
    var i = 0
    while i < n {
        if s.char_at(i).starts_with("\n") {
            out.push(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.push(s.substring(start, n))
    return out
}

// Path manipulation on `/` separators. Forward slash works on Windows for
// these std ops; the OS separator is not detected. These overlap with
// std.path; they are duplicated here so std.fs is usable without a second
// import.

// Byte index of the last `/`, or -1 when none.
fun last_slash(p: str) -> int {
    var i = p.length() - 1
    while i >= 0 {
        if p.char_at(i).starts_with("/") {
            return i
        }
        i = i - 1
    }
    return -1
}

fun join(a: str, b: str) -> str {
    if a.length() == 0 {
        return b
    }
    if b.length() == 0 {
        return a
    }
    let a_slash = a.ends_with("/")
    let b_slash = b.starts_with("/")
    if a_slash {
        if b_slash {
            return a.concat(b.substring(1, b.length()))
        }
        return a.concat(b)
    }
    if b_slash {
        return a.concat(b)
    }
    return a.concat("/").concat(b)
}

fun basename(p: str) -> str {
    var i = last_slash(p)
    if i < 0 {
        return p
    }
    return p.substring(i + 1, p.length())
}

fun dirname(p: str) -> str {
    var i = last_slash(p)
    if i < 0 {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return p.substring(0, i)
}

// Split `p` on `/` into its components, dropping empty pieces produced by
// leading, trailing, or repeated separators.
fun split(p: str) -> list[str] {
    let out: list[str] = []
    let n = p.length()
    var start = 0
    var i = 0
    while i < n {
        if p.char_at(i).starts_with("/") {
            if i > start {
                out.push(p.substring(start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if n > start {
        out.push(p.substring(start, n))
    }
    return out
}
