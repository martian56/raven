// Sample Raven program for exercising the VS Code extension grammar.

from std.io import println
from std.sync import channel, channel_buffered, yield_now
from std.ffi import alloc, free, load, store, offset

@derive(Eq, Hash, ToString, Debug)
class User {
    id: int
    name: str
}

@repr(C)
class Header {
    tag: CInt
    len: CInt
}

// Declarative macro plus a call site below.
macro twice { ($x:expr) => { ($x) + ($x) } }

extern "C" {
    fun raven_ffi_qsort_i32(p: CPtr[CInt], n: CSize, cmp: CFnPtr)
}

class Point[T] {
    x: T
    y: T
}

enum Shape {
    Circle(float),
    Square(float),
}

trait Area {
    fun area(self) -> float
}

impl Area for Shape {
    fun area(self) -> float = match self {
        case Circle(r) { r * r * 3.14159 }
        case Square(w) { w * w }
    }
}

fun describe[T: ToString](value: T) -> str = value.to_string()

extern "C" {
    fun strlen(s: CStr) -> CSize
}

fun main() {
    let name = "Raven"
    let count = 42
    println("Hello, ${name}! count = ${count}")

    let nums = [1, 2, 3, 4, 5]
    var total = 0
    for n in nums {
        total += n
    }
    print(total)

    for i in 0..3 {
        if i == 1 {
            continue
        }
        print(i)
    }

    let s = Shape.Circle(2.0)
    print(describe(s.area()))

    let n = strlen(c"hello") as int
    print(n)

    print(twice!(n + 1))

    let u = User(id: 7, name: "ada")
    let a = to_any[User](u)
    print(type_name_of(a))

    let ch = channel()
    spawn {
        ch.send(1)
        yield_now()
    }
    print(ch.recv())

    let buf = alloc[CInt](4)
    store[CInt](buf, 10)
    print(load[CInt](offset[CInt](buf, 0)))
    free[CInt](buf)
}
