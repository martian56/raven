{
  "Variable Binding": {
    "prefix": "let",
    "body": ["let ${1:name}: ${2:int} = ${3:value}"],
    "description": "Bind a name with a type annotation"
  },
  "Variable Binding (inferred)": {
    "prefix": "leti",
    "body": ["let ${1:name} = ${2:value}"],
    "description": "Bind a name with an inferred type"
  },
  "Mutable Binding": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:value}"],
    "description": "Declare a reassignable variable"
  },
  "Function Declaration": {
    "prefix": "fun",
    "body": ["fun ${1:name}(${2:params}) -> ${3:int} {", "\t${4:body}", "}"],
    "description": "Declare a function with parameters and a return type"
  },
  "Expression Function": {
    "prefix": "fune",
    "body": ["fun ${1:name}(${2:params}) -> ${3:int} = ${4:expr}"],
    "description": "Declare an expression-bodied function"
  },
  "Generic Function": {
    "prefix": "fung",
    "body": ["fun ${1:name}[${2:T}: ${3:ToString}](${4:x}: ${2:T}) -> ${5:str} {", "\t${6:body}", "}"],
    "description": "Declare a generic function with a trait bound"
  },
  "Main Function": {
    "prefix": "main",
    "body": ["fun main() {", "\t${1:body}", "}"],
    "description": "Program entry point"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t${2:body}", "}"],
    "description": "Conditional block"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "\t${2:then}", "} else {", "\t${3:otherwise}", "}"],
    "description": "Conditional with an else branch"
  },
  "Else-If Chain": {
    "prefix": "elseif",
    "body": ["else if ${1:condition} {", "\t${2:body}", "}"],
    "description": "Another condition in an if chain"
  },
  "Conditional Value": {
    "prefix": "ifv",
    "body": ["${1:a} if ${2:condition} else ${3:b}"],
    "description": "A value chosen by a condition"
  },
  "While Loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t${2:body}", "}"],
    "description": "Loop while a condition holds"
  },
  "Infinite Loop": {
    "prefix": "loop",
    "body": ["loop {", "\t${1:body}", "}"],
    "description": "Loop until break"
  },
  "For Loop (range)": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:0}..${3:n} {", "\t${4:body}", "}"],
    "description": "Loop over a range"
  },
  "For Loop (collection)": {
    "prefix": "foreach",
    "body": ["for ${1:item} in ${2:items} {", "\t${3:body}", "}"],
    "description": "Loop over a list, set, dict, or string"
  },
  "For Loop (enumerate)": {
    "prefix": "forenum",
    "body": ["for (${1:i}, ${2:item}) in enumerate(${3:items}) {", "\t${4:body}", "}"],
    "description": "Loop with each item's position"
  },
  "List Comprehension": {
    "prefix": "comp",
    "body": ["[${1:x} for ${2:x} in ${3:items} if ${4:condition}]"],
    "description": "Build a list from a loop"
  },
  "Dict Comprehension": {
    "prefix": "dcomp",
    "body": ["{${1:k}: ${2:v} for ${3:k} in ${4:items}}"],
    "description": "Build a dict from a loop"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "\tcase ${2:Pattern} {", "\t\t${3:body}", "\t}", "\tcase _ {", "\t\t${4:fallback}", "\t}", "}"],
    "description": "Match a value against patterns"
  },
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "\t${2:field}: ${3:int}", "", "\tfun ${4:method}(self) -> ${5:int} {", "\t\t${6:body}", "\t}", "}"],
    "description": "Define a class with fields and a method"
  },
  "Generic Class": {
    "prefix": "classg",
    "body": ["class ${1:Name}[${2:T}] {", "\t${3:value}: ${2:T}", "}"],
    "description": "Define a generic class"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Variant1},", "\t${3:Variant2}(${4:int}),", "}"],
    "description": "Define an enum"
  },
  "Trait": {
    "prefix": "trait",
    "body": ["trait ${1:Name} {", "\tfun ${2:method}(self) -> ${3:int}", "}"],
    "description": "Define a trait"
  },
  "Trait With Method Body": {
    "prefix": "traitm",
    "body": ["trait ${1:Name} {", "\tfun ${2:method}(self) -> ${3:str} {", "\t\t${4:body}", "\t}", "}"],
    "description": "Define a trait with a default method"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "\tfun ${2:method}(self) -> ${3:int} {", "\t\t${4:body}", "\t}", "}"],
    "description": "Add methods to a type declared elsewhere"
  },
  "Impl Trait For Type": {
    "prefix": "implfor",
    "body": ["impl ${1:Trait} for ${2:Type} {", "\tfun ${3:method}(self) -> ${4:int} {", "\t\t${5:body}", "\t}", "}"],
    "description": "Implement a trait for a type declared elsewhere"
  },
  "Extern Block": {
    "prefix": "extern",
    "body": ["extern \"C\" {", "\tfun ${1:name}(${2:params}) -> ${3:CInt}", "}"],
    "description": "Declare C functions"
  },
  "Import Module": {
    "prefix": "import",
    "body": ["import std.${1:fs}"],
    "description": "Import a module"
  },
  "Import Selective": {
    "prefix": "from",
    "body": ["from std.${1:json} import ${2:parse}"],
    "description": "Import names from a module"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": ["(${1:x}) => ${2:x * 2}"],
    "description": "Anonymous function"
  },
  "Assert": {
    "prefix": "assert",
    "body": ["assert ${1:condition}, \"${2:message}\""],
    "description": "Stop with a message when a condition is false"
  },
  "Defer": {
    "prefix": "defer",
    "body": ["defer ${1:cleanup()}"],
    "description": "Run an expression when the function returns"
  },
  "Print": {
    "prefix": "print",
    "body": ["print(${1:value})"],
    "description": "Print values separated by spaces"
  },
  "Print Interpolated": {
    "prefix": "printi",
    "body": ["print(\"${1:label}: \\${${2:value}}\")"],
    "description": "Print an interpolated string"
  },
  "Spawn Goroutine": {
    "prefix": "spawn",
    "body": ["spawn {", "\t${1:body}", "}"],
    "description": "Run a block on another goroutine"
  },
  "Spawn Task": {
    "prefix": "task",
    "body": ["let ${1:task} = spawn {", "\t${2:body}", "}", "${1:task}.join()"],
    "description": "Run a block and wait for it"
  },
  "Channel": {
    "prefix": "channel",
    "body": ["let ${1:ch}: Channel[${2:int}] = channel()"],
    "description": "Create an unbuffered channel"
  },
  "Buffered Channel": {
    "prefix": "channelb",
    "body": ["let ${1:ch}: Channel[${2:int}] = channel_buffered(${3:16})"],
    "description": "Create a buffered channel"
  },
  "Derive Attribute": {
    "prefix": "derive",
    "body": ["@derive(${1:Ord})"],
    "description": "Generate trait implementations"
  },
  "Repr C Attribute": {
    "prefix": "repr",
    "body": ["@repr(C)", "class ${1:Name} {", "\t${2:field}: ${3:CInt}", "}"],
    "description": "A class laid out like a C struct"
  },
  "Macro Definition": {
    "prefix": "macro",
    "body": ["macro ${1:name} { (${2:\\$x:expr}) => { ${3:body} } }"],
    "description": "Define a declarative macro"
  },
  "To Any": {
    "prefix": "toany",
    "body": ["to_any[${1:T}](${2:value})"],
    "description": "Box a value as Any"
  },
  "Cast From Any": {
    "prefix": "cast",
    "body": ["cast[${1:T}](${2:any})"],
    "description": "Recover a typed value from Any"
  }
}
