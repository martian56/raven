// match on str literal patterns compares by content. Regression for
// issue #265, where string-literal arms compared heap-pointer identity and
// always fell through to the wildcard. Prints:
//   affirmative
//   negative
//   unknown
fun classify(s: str) -> str {
    return match s {
        case "yes" { "affirmative" }
        case "no" { "negative" }
        case _ { "unknown" }
    }
}

fun main() {
    print(classify("yes"))
    print(classify("no"))
    print(classify("maybe"))
}
