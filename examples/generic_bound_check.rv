// A generic class used as a Map key must satisfy the key's Eq and Hash bounds.
// Deriving them makes Box[int] a valid key; without them it is a clear type
// error rather than an unresolved callee at code generation.
from std.io import println
import std.collections

@derive(Eq, Hash)
class Box[T] {
    value: T
}

fun main() {
    let m: dict[Box[int], int] = Map.new()
    m.set(Box(value: 7), 42)
    match m.get(Box(value: 7)) {
        case Some(v) { println(v.to_string()) }
        case None { println("none") }
    }
}
