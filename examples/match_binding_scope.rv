// A match arm's pattern binding is scoped to the arm, so a same-named
// variable in the enclosing scope keeps its value after the match, and nested
// matches shadow correctly. Prints:
//   99
//   7
//   2
//   1
from std.io import println

fun main() {
    let v = 7
    match Some(99) {
        case Some(v) { println(v.to_string()) }
        case None {}
    }
    println(v.to_string())

    match Some(1) {
        case Some(x) {
            match Some(2) {
                case Some(x) { println(x.to_string()) }
                case None {}
            }
            println(x.to_string())
        }
        case None {}
    }
}
