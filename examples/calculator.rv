// A non-interactive calculator over a fixed set of operations.
fun apply(op: str, a: float, b: float) -> float {
    if op == "+" {
        a + b
    } else if op == "-" {
        a - b
    } else if op == "*" {
        a * b
    } else {
        a / b
    }
}

fun main() {
    let a = 10.0
    let b = 5.0
    print(apply("+", a, b))
    print(apply("-", a, b))
    print(apply("*", a, b))
    print(apply("/", a, b))
}
