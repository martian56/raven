// Regression for #513: a class error payload carried through `Result` whose
// Ok type has a different machine representation than the error (here `bool`).
// The match arm binding `Err(e)` must be typed as the error class, not the Ok
// payload; getting that wrong corrupted the pointer and crashed at runtime.
from std.io import println
import std.string

class Fail {
    code: int
    message: str
}

fun check(n: int) -> Result[bool, Fail] {
    if n < 0 {
        return Err(Fail(code: 1, message: "negative"))
    }
    return Ok(true)
}

fun run(n: int) -> Result[int, Fail] {
    let _ok = check(n)?
    return Ok(n * 2)
}

fun main() {
    match run(5) {
        case Ok(v) { println(v.to_string()) }
        case Err(e) { println(e.message) }
    }
    match run(0 - 3) {
        case Ok(v) { println(v.to_string()) }
        case Err(e) { println(e.message.concat(" code=").concat(e.code.to_string())) }
    }
}
