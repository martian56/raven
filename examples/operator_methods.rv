class Vec2 {
    x: float
    y: float

    fun add(self, o: Vec2) -> Vec2 = Vec2(self.x + o.x, self.y + o.y)

    fun sub(self, o: Vec2) -> Vec2 = Vec2(self.x - o.x, self.y - o.y)

    fun mul(self, k: float) -> Vec2 = Vec2(self.x * k, self.y * k)

    fun neg(self) -> Vec2 = Vec2(-self.x, -self.y)
}

class Money: Ord {
    cents: int

    fun compare(self, other: Money) -> int = self.cents - other.cents
}

fun main() {
    let a = Vec2(1.0, 2.0)
    let b = a + Vec2(3.0, 4.0) - Vec2(1.0, 1.0)
    let c = -(b * 2.0)
    print("${b.x} ${b.y} ${c.x} ${c.y}")
    let cheap = Money(100)
    let dear = Money(250)
    print("${cheap < dear} ${cheap >= dear} ${dear > cheap}")
    print("${(1, 2) < (1, 3)} ${(2, 0) <= (1, 9)}")
    let words = [("b", 2), ("a", 9), ("a", 1)]
    print(sorted(words))
}
