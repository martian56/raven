// Regressions for stdlib robustness fixes: non-finite float
// formatting (#555), a capped parse_float exponent (#427), and JSON validation
// of leading zeros and raw control bytes (#558). Prints:
//   inf
//   NaN
//   ok-bigexp
//   reject-leadingzero
//   reject-control
from std.fmt import format_float
from std.json import parse
import std.string
from std.io import println

fun main() {
    let zero = 0.0
    println(format_float(1.0 / zero, 2))
    println(format_float(zero / zero, 2))
    match "1e999999999".parse_float() {
        case Some(v) { println("ok-bigexp") }
        case None { println("rejected-bigexp") }
    }
    match parse("01") {
        case Ok(v) { println("BAD-leadingzero") }
        case Err(e) { println("reject-leadingzero") }
    }
    match parse("\"a\tb\"") {
        case Ok(v) { println("BAD-control") }
        case Err(e) { println("reject-control") }
    }
}
