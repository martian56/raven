// weighted_choice must ignore non-positive weights rather than summing them: a
// negative weight beside positive ones used to shrink the total to <= 0 and make
// every draw return None, hiding the reachable positive items.
import std.random
from std.io import println

fun main() {
    let rng = Rng.new(0)
    let xs = ["a", "b", "c"]
    // b carries a negative weight; only a and c can be drawn.
    let weights = [1, 0 - 5, 2]

    var drew_b = false
    var none = 0
    var drew_c = 0
    var i = 0
    while i < 1000 {
        match rng.weighted_choice(xs, weights) {
            case Some(v) {
                if v == "b" {
                    drew_b = true
                }
                if v == "c" {
                    drew_c = drew_c + 1
                }
            }
            case None {
                none = none + 1
            }
        }
        i = i + 1
    }

    println("never None: ${none == 0}")
    println("negative-weight item never drawn: ${not drew_b}")
    println("positive item past it reachable: ${drew_c > 0}")

    let huge_xs = ["a", "b"]
    let huge_weights = [9223372036854775807, 9223372036854775807]
    var huge_a = 0
    var huge_b = 0
    var seed = 0
    while seed < 40 {
        let huge_rng = Rng.new(seed)
        match huge_rng.weighted_choice(huge_xs, huge_weights) {
            case Some(v) {
                if v == "a" {
                    huge_a = huge_a + 1
                }
                if v == "b" {
                    huge_b = huge_b + 1
                }
            }
            case None {}
        }
        seed = seed + 1
    }
    println("huge equal weights both reachable: ${huge_a > 0 and huge_b > 0}")
}
