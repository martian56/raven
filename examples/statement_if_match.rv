// An if or match used as a statement, or with a branch that has no value,
// does not need its branches to agree on a type.
class Box {
    n: int
}

impl Box {
    fun bump(self) -> Box {
        self.n += 1
        return self
    }
}

fun pick(o: Option[int], b: Box) {
    match o {
        case Some(v) { b.bump() }
        case None {}
    }
    if b.n > 5 {
        b.bump()
    } else if b.n > 1 {
        b.bump().bump()
    }
}

fun options(n: int) {
    if n > 0 {
        Some(1)
    } else {
        None
    }
    match n {
        case 0 { Some("a") }
        case _ { None }
    }
    let mixed = match n {
        case 0 { 1 }
        case 1 { "one" }
        case _ {}
    }
    print("options ${n}")
}

fun first_even(xs: list[int]) -> Result[int, str] {
    let check = (x: int) => {
        let half = halve(x)?
        return Ok(half * 2)
    }
    for x in xs {
        match check(x) {
            case Ok(v) { return Ok(v) }
            case Err(_) {}
        }
    }
    return Err("none")
}

fun halve(x: int) -> Result[int, str] {
    if x % 2 == 0 {
        return Ok(x / 2)
    }
    return Err("odd")
}

fun main() {
    options(0)
    options(2)
    print(first_even([3, 5, 8, 9]).unwrap(), first_even([1]).is_err())
    let b = Box(n: 0)
    pick(Some(1), b)
    pick(None, b)
    pick(Some(2), b)
    print(b.n)
    let v = match b.n {
        case 4 { "four" }
        case _ { "other" }
    }
    print(v)
}
