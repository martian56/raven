// A JSON exponent is capped while its digits are read, so a huge exponent
// saturates to infinity instead of overflowing int and wrapping into a small
// step count. Normal exponents are unaffected. Prints:
//   1e19... -> inf
//   1e40... -> inf
//   1e2 -> 100
//   1.5e3 -> 1500
//   1e-3 -> 0.001
//   1e309 -> inf
from std.json import parse
from std.io import println
import std.string

fun show(label: str, text: str) {
    println(
        match parse(text) {
            case Ok(value) {
                match value.as_number() {
                    case Some(n) { "${label} -> ${n}" }
                    case None { "${label} -> not a number" }
                }
            }
            case Err(e) { "${label} -> Err(${e.message})" }
        },
    )
}

fun main() {
    show("1e19...", "1e".concat("9".repeat(19)))
    show("1e40...", "1e".concat("9".repeat(40)))
    show("1e2", "1e2")
    show("1.5e3", "1.5e3")
    show("1e-3", "1e-3")
    show("1e309", "1e309")
}
