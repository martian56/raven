from std.crypto import (
    sha256_hex,
    sha512_hex,
    hmac_sha256_hex,
    pbkdf2_sha256,
    to_hex,
    random_bytes,
    random_hex,
    constant_time_eq,
    hash_password,
    verify_password,
)

fun main() {
    print(sha256_hex("abc"))
    print(sha256_hex(""))
    print(sha512_hex("abc").substring(0, 32))
    print(hmac_sha256_hex("Jefe", "what do ya want for nothing?"))
    print(to_hex(pbkdf2_sha256("password", "salt", 1, 32)))
    print(len(random_bytes(32)))
    let a = random_hex(16)
    print(len(a), a != random_hex(16))
    print(constant_time_eq("token", "token"), constant_time_eq("token", "tokem"), constant_time_eq("a", "ab"))
    let stored = hash_password("hunter2")
    print(stored.starts_with("pbkdf2-sha256$210000$"), stored != hash_password("hunter2"))
    print(verify_password("hunter2", stored), verify_password("hunter3", stored), verify_password("x", "garbage"))
}
