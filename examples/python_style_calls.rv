// print's sep and end keywords, spawn of a call, str.chars, and a module-level
// list whose type is inferred from its literals.
from std.sync import WaitGroup, Mutex

let NAMES = ["ada", "grace", "linus"]

class Tally {
    total: int
}

fun add(t: Tally, lock: Mutex, n: int, wg: WaitGroup) {
    lock.lock()
    t.total += n
    lock.unlock()
    wg.done()
}

fun register(wg: WaitGroup) -> int {
    wg.add(1)
    return 100
}

fun main() {
    print("a", "b", "c", sep: "-")
    print(1, 2, 3, sep: ", ", end: ".\n")
    for name in NAMES {
        print(name, end: " ")
    }
    print()
    for c in "héllo".chars() {
        print(c, end: "|")
    }
    print()

    let t = Tally(0)
    let lock = Mutex.new()
    let wg = WaitGroup.new()
    for i in range(1, 11) {
        wg.add(1)
        spawn add(t, lock, i, wg)
    }
    wg.wait()
    print("total", t.total)

    // Arguments are evaluated at the spawn, so register() runs before wait().
    spawn add(t, lock, register(wg), wg)
    wg.wait()
    print("total", t.total)
}
