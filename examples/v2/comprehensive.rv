// A tour of core language features: variables, conditionals, loops,
// functions, structs, and arithmetic, all with deterministic output.
class Rect {
    w: int
    h: int
}

fun area(r: Rect) -> int = r.w * r.h

fun multiply(a: int, b: int) -> int = a * b

fun main() {
    let name = "Raven"
    print(name)

    let x = 10
    let y = 20
    if x < y {
        print("x is less than y")
    }

    var i = 0
    while i < 3 {
        print(i)
        i = i + 1
    }

    for j in 0..3 {
        print(j * 2)
    }

    print(multiply(6, 7))

    let active = true
    let access = true
    if active and access {
        print("Access granted")
    }

    print(5 + 10)
    print(20 - 8)
    print(6 * 7)
    print(100 / 4)

    let r = Rect(w: 4, h: 5)
    print(area(r))
}
