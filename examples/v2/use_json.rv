// golden:skip
from std.json import parse, stringify
from std.io import println

fun main() {
    match parse("{\"a\": 1, \"b\": [true, null, \"hi\"]}") {
        case Ok(v) { println(stringify(v)) }
        case Err(e) { println("parse failed") }
    }
    match parse("\"x\\ny \\u0041\"") {
        case Ok(v) { println(stringify(v)) }
        case Err(e) { println("parse failed") }
    }
    match parse("{ bad ]") {
        case Ok(v) { println("ok") }
        case Err(e) { println("parse failed") }
    }
    let bad_utf8 = "\"".concat(__str_from_byte(255)).concat("\"")
    match parse(bad_utf8) {
        case Ok(v) { println("ok") }
        case Err(e) { println("invalid utf8 rejected") }
    }
}
