fun loops() {
    var out: list[int] = []
    for i in (0..10).step(3) {
        out.push(i)
    }
    for i in (10..0).step(-4) {
        out.push(i)
    }
    for i in (1..=7).step(3) {
        out.push(i)
    }
    print(out)
    var s = 0
    for i in 0..10 {
        if i % 2 == 0 {
            continue
        }
        s += i
    }
    for i in 0..=3 {
        s += i
    }
    for x in [5, 6] {
        if x == 5 {
            continue
        }
        s += x
    }
    print(s)
    print((0..10).step(4))
    var big = 0
    for i in 9223372036854775805..=9223372036854775807 {
        big += 1
    }
    print(big)
}

fun slices() {
    let xs = [10, 20, 30, 40, 50]
    print(xs[1..3])
    print(xs[0..=2])
    let s = "hello world"
    print(s[0..5])
    print(s[6..=10])
}

fun casts() {
    let n = 7
    let half = n as float / 2.0
    let xs = [1, 2, 3, 4]
    let avg = sum(xs) as float / len(xs) as float
    print("${half} ${avg} ${3.99 as int} ${-3.99 as int} ${true as int} ${n as str + "!"}")
}

fun main() {
    loops()
    slices()
    casts()
}
