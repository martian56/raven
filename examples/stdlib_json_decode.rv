// Decode a JSON string into a class with std.json's `decode`, then re-serialize
// it with the `@derive(ToJson)` impl. The two derives synthesize the conversions.
from std.json import decode, stringify, ToJson
from std.io import println

@derive(ToJson, FromJson)
class User {
    name: str
    age: int
}

fun main() {
    match decode[User]("{\"name\":\"Ada\",\"age\":36}") {
        case Ok(u) {
            println("name=${u.name} age=${u.age}")
            println(stringify(u.to_json()))
        }
        case Err(e) { println("decode error") }
    }
}
