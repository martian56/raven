fun main() {
    let n = 20000000
    let flags = [true] * (n + 1)
    var count = 0
    var p = 2
    while p <= n {
        if flags[p] {
            count += 1
            var m = p * p
            while m <= n {
                flags[m] = false
                m += p
            }
        }
        p += 1
    }
    print(count)
}
