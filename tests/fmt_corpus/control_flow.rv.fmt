// if-expression, match with guards, while, loop, for, defer, break/continue

fun classify(x: int) -> str {
    let label = if x < 0 {
        "neg"
    } else if x == 0 {
        "zero"
    } else {
        "pos"
    }
    return label
}

fun sign(x: int) -> int {
    return match x {
        case 0 { 0 }
        case n if n > 0 { 1 }
        case _ { -1 }
    }
}

fun count() -> int {
    var total = 0
    for i in 0..10 {
        if i == 5 {
            continue
        }
        total += i
    }
    var n = 0
    while n < 3 {
        n += 1
    }
    loop {
        break
    }
    defer cleanup()
    return total
}
