// structs, enums with all payload kinds, traits, and impls

class Point {
    x: int
    y: int
}

class Empty {}

enum Shape {
    Circle(float),
    Rect(w: float, h: float),
    Nothing,
}

trait Area {
    fun area(self) -> float

    fun name(self) -> str = "shape"
}

impl Area for Point {
    fun area(self) -> float {
        return 0.0
    }
}

impl[T] Wrapper[T] {
    fun get(self) -> T {
        return self.value
    }
}
