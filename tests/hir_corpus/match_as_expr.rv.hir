(hir
  (fn "bool_to_int" params=("b":bool) ret=int
    (body ty=()
      (let "n" ty=int
        (match ty=int
          (ident "b" ty=bool)
          (arm
            (pat true)
                        (block ty=int
              (tail
                (int 1 ty=int)
              )
            )
          )
          (arm
            (pat false)
                        (block ty=int
              (tail
                (int 0 ty=int)
              )
            )
          )
        )
      )
      (stmt-expr
        (return ty=<error>
          (ident "n" ty=int)
        )
      )
    )
  )
)
