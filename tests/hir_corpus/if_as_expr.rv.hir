(hir
  (fn "pick" params=("flag":bool "a":int "b":int) ret=int
    (body ty=()
      (let "x" ty=int
        (if ty=int
          (ident "flag" ty=bool)
          (then ty=int
            (tail
              (ident "a" ty=int)
            )
          )
          (else ty=int
            (tail
              (ident "b" ty=int)
            )
          )
        )
      )
      (stmt-expr
        (return ty=<error>
          (ident "x" ty=int)
        )
      )
    )
  )
)
