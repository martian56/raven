(file
  (enum "Shape"
    (variant "Circle" tuple(Float))
    (variant "Square" tuple(Float))
    (variant "Empty")
  )
  (fn "area" params=("s":Shape) ret=Float
    (body
      (trailing
        (match
          (ident "s")
          (arm
            (pattern "Circle"{"radius":ident:"r"})
            (body
                            (block
                (trailing
                  (binary *
                    (ident "r")
                    (ident "r")
                  )
                )
              )
            )
          )
          (arm
            (pattern "Square"{"side":ident:"w"})
            (body
                            (block
                (trailing
                  (binary *
                    (ident "w")
                    (ident "w")
                  )
                )
              )
            )
          )
          (arm
            (pattern ident:"Empty")
            (body
                            (block
                (trailing
                  (float 0)
                )
              )
            )
          )
        )
      )
    )
  )
)
